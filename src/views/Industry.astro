---
import Base from '../layouts/Base.astro';
import { ltr } from '../lib/bidi';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProductCard from '../components/ProductCard.astro';
import ServiceStrip from '../components/ServiceStrip.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { brands } from '../data/brands';
import { productsOf, brandPath } from '../data/catalog';
import { families, categoryPath, renderOf } from '../data/equipment';
import { industryContent } from '../data/industryContent';
import type { Industry as Ind } from '../data/industries';
import { breadcrumbLd, faqLd } from '../data/schema';
import { t, localize, type Lang } from '../i18n';
import { titleOf, descOf } from '../lib/seo';

interface Props { lang: Lang; industry: Ind }
const { lang, industry } = Astro.props;
const ar = lang === 'ar';
const L = (x: string) => localize(lang, x);
const c = industryContent[industry.slug];
const featured = c.brands.map((s) => brands.find((b) => b.slug === s)!).filter(Boolean);
const rank = (slug: string) => { const i = c.brands.indexOf(slug); return i < 0 ? c.brands.length : i; };
const items = brands
  .flatMap((b) => productsOf(b.slug).filter((p) => p.priority !== 'niche' && p.industries.includes(industry.slug)).map((p) => ({ b, p })))
  // The sector's own brands first (in its order), flagships first within a brand, at most 3 per brand so the grid stays varied.
  .sort((x, y) => rank(x.b.slug) - rank(y.b.slug) || Number(y.p.priority === 'flagship') - Number(x.p.priority === 'flagship'))
  .filter((x, i, all) => all.slice(0, i).filter((y) => y.b.slug === x.b.slug).length < 3)
  .slice(0, 8);
// Tier-2 (unbranded) equipment relevant to this sector, grouped by family; the tagging lives on each category in equipment.json.
const equip = families
  .map((f) => ({ f, cats: f.categories.filter((x) => x.industries.includes(industry.slug)) }))
  .filter((g) => g.cats.length > 0);
const faqs = c.faqs.map((f) => ({ q: f.q[lang], a: f.a[lang] }));
const crumbs = [
  { label: ar ? 'الرئيسية' : 'Home', href: L('/') },
  { label: t(lang, 'nav.industries'), href: L('/industries/') },
  { label: industry.name[lang] },
];
const url = L(`/industries/${industry.slug}/`);
const title = titleOf(ar ? `أجهزة ${industry.name.ar} في الإمارات` : `${industry.name.en} Lab Instruments UAE`, ['AlyTech', '']);
---
<Base lang={lang} title={title} description={descOf(c.intro[lang])} schema={[faqLd(faqs), breadcrumbLd(crumbs, url)]}>
  <section class="border-b border-line bg-card pt-[72px]">
    <div class="wrap py-12 md:py-16">
      <Breadcrumbs items={crumbs} />
      <p class="label mt-10 text-brand-600">{t(lang, 'nav.industries')}</p>
      <h1 class="display mt-3 text-[clamp(2.2rem,5vw,4rem)]">{industry.name[lang]}</h1>
      <p class="mt-5 max-w-3xl text-[18px] leading-relaxed text-ink-soft" set:html={ltr(c.intro[lang], lang)} />
      <ul class="mt-8 flex flex-wrap gap-2">
        {featured.map((b) => <li><a href={L(brandPath(b))} class="inline-flex items-center gap-2 rounded-full border border-line-strong px-3.5 py-1.5 text-[14px] font-medium transition-colors hover:border-brand-500 hover:text-brand-700">{b.name}<Icon name="arrow" size={14} flip /></a></li>)}
      </ul>
    </div>
  </section>

  {items.length > 0 && (
    <section class="py-14 md:py-20" aria-labelledby="ind-prod-h">
      <div class="wrap">
        <h2 id="ind-prod-h" class="display text-[clamp(1.6rem,3vw,2.4rem)]">{ar ? 'أجهزة مختارة لهذا القطاع' : 'Instruments for this sector'}</h2>
        <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {items.map(({ b, p }) => <ProductCard lang={lang} brand={b} product={p} />)}
        </div>
      </div>
    </section>
  )}

  {equip.length > 0 && (
    <section class="border-t border-line py-14 md:py-20" aria-labelledby="ind-eq-h">
      <div class="wrap">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <h2 id="ind-eq-h" class="display text-[clamp(1.6rem,3vw,2.4rem)]">{t(lang, 'ind.equip.title')}</h2>
            <p class="mt-3 max-w-2xl text-[16px] text-mute">{t(lang, 'ind.equip.lead')}</p>
          </div>
          <a href={L('/equipment/')} class="link-arrow">{t(lang, 'ind.equip.all')} <Icon name="arrow" size={16} flip /></a>
        </div>
        <div class="mt-8">
          {equip.map(({ f, cats }) => (
            <div class="grid gap-4 border-b border-line py-8 last:border-0 lg:grid-cols-[1fr_2fr] lg:gap-14">
              <h3 class="display text-[clamp(1.2rem,2vw,1.5rem)]">{(ar && f.ar?.name) || f.name}</h3>
              <ul class="grid gap-2 sm:grid-cols-2">
                {cats.map((cat) => (
                  <li>
                    <a href={L(categoryPath(cat))} class="group flex h-full items-start gap-4 rounded-sm border border-transparent p-3 transition-[background-color,border-color] duration-200 hover:border-line hover:bg-card">
                      {renderOf(cat.slug) && <img src={renderOf(cat.slug).sm} width="112" height="84" alt="" loading="lazy" decoding="async" class="h-[84px] w-28 shrink-0 rounded-xs object-cover" />}
                      <span class="flex-1 py-1">
                        <span class="block font-semibold">{(ar && cat.ar?.name) || cat.name}</span>
                        <span class="mt-1 line-clamp-2 text-[14px] text-mute" lang={ar && !cat.ar?.summary ? 'en' : undefined} set:html={ltr((ar && cat.ar?.summary) || cat.summary, lang)} />
                      </span>
                      <Icon name="arrow" size={18} flip class="mt-2 shrink-0 text-mute transition-[color,transform] duration-200 group-hover:translate-x-1 group-hover:text-brand-600 rtl:group-hover:-translate-x-1" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="border-t border-line bg-card py-14 md:py-20" aria-labelledby="faq-h">
    <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.6fr]">
      <div>
        <h2 id="faq-h" class="display text-[clamp(1.6rem,3vw,2.4rem)]">{ar ? 'أسئلة شائعة' : 'Common questions'}</h2>
        <p class="mt-4 text-mute">{ar ? 'لم تجد إجابتك؟' : 'Not covered here?'}</p>
        <button type="button" class="link-arrow mt-2" data-lead="whatsapp" data-product={industry.name.en}><Icon name="whatsapp" size={18} />{t(lang, 'cta.whatsapp')}</button>
      </div>
      <Faq items={faqs} />
    </div>
  </section>

  <ServiceStrip lang={lang} />
</Base>
