---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import OfficeMap from '../components/OfficeMap.astro';
import { site } from '../data/site';
import { getSiteSettings } from '../lib/settings';
import { breadcrumbLd } from '../data/schema';
import { t, localize, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === 'ar';
const cfg = await getSiteSettings();
const hours = ar ? cfg.hours.ar : cfg.hours.en;

// What a visitor can expect after contacting us (the reply time is the commitment stated in the lead form).
const next = ar
  ? [
      { h: 'أخبرنا بما تحتاجه', p: 'أرسل اسم الجهاز أو المعيار الذي تختبر وفقه أو صورة العيّنة.' },
      { h: 'يرد عليك مهندس', p: 'يرد مهندس تطبيقات خلال يوم عمل واحد، وغالباً أسرع بكثير، ويؤكد التهيئة المناسبة.' },
      { h: 'عرض السعر والتسليم', p: 'تتلقى عرض السعر، وبعد طلبك نورّد الجهاز ونركّبه ونشغّله وندرّب فريقك في الموقع.' },
    ]
  : [
      { h: 'Tell us what you need', p: 'Send the instrument name, the standard you test to, or a photo of your sample.' },
      { h: 'An engineer replies', p: 'An application engineer replies within one working day, usually much sooner, and confirms the right configuration.' },
      { h: 'Quotation and delivery', p: 'You receive a quotation; after your order we deliver, install, commission and train your team on site.' },
    ];
const L = (x: string) => localize(lang, x);
const crumbs = [{ label: ar ? 'الرئيسية' : 'Home', href: L('/') }, { label: t(lang, 'nav.contact') }];
---
<Base
  lang={lang}
  title={ar ? 'تواصل مع AlyTech Scientific | أبوظبي' : 'Contact AlyTech Scientific | Abu Dhabi, UAE'}
  description={ar ? 'تواصل مع مهندسي AlyTech Scientific عبر واتساب أو البريد الإلكتروني، أو زر مكتبنا في مصفح بأبوظبي. نرد خلال يوم عمل واحد.' : 'Reach an AlyTech Scientific engineer on WhatsApp or by email, or visit our office in Mussafah, Abu Dhabi. We reply within one working day.'}
  schema={[breadcrumbLd(crumbs, L('/contact/'))]}
>
  <section class="bg-card pt-[72px]">
    <div class="wrap py-12 md:py-16">
      <Breadcrumbs items={crumbs} />
      <h1 class="display mt-10 max-w-3xl text-[clamp(2.2rem,5vw,4rem)]">{ar ? 'تحدث مع مهندس، لا مع موظف مبيعات.' : 'Talk to an engineer, not a call center.'}</h1>
      <p class="mt-5 max-w-xl text-[17px] text-mute">{t(lang, 'lead.sub.default')}</p>

      <div class="mt-12 grid gap-3 md:grid-cols-[1.3fr_1fr_1fr]">
        <button type="button" data-lead="whatsapp" class="group on-dark flex min-h-[220px] flex-col gap-6 rounded-[var(--radius-md)] bg-night-900 p-7 text-start text-white transition-shadow duration-200 hover:shadow-[var(--shadow-pop)]">
          <span class="flex h-12 w-12 items-center justify-center rounded-full bg-whatsapp"><Icon name="whatsapp" size={24} /></span>
          <span class="flex flex-1 flex-col">
            <span class="display block text-2xl">{t(lang, 'wa.label')}</span>
            <span class="mt-1 block text-white/70">{ar ? 'الطريقة الأسرع. أرسل اسم الجهاز أو صورة العيّنة.' : 'Fastest. Send the instrument name or a photo of your sample.'}</span>
            <span class="link-arrow mt-auto pt-4">{ar ? 'ابدأ المحادثة' : 'Start a chat'} <Icon name="arrow" size={16} flip /></span>
          </span>
        </button>
        <button type="button" data-lead="quote" class="group card flex min-h-[220px] flex-col gap-6 p-7 text-start transition-[border-color,box-shadow] duration-200 hover:border-brand-200 hover:shadow-[var(--shadow-card)]">
          <span class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-50 text-brand-600"><Icon name="package" size={22} /></span>
          <span class="flex flex-1 flex-col">
            <span class="display block text-2xl">{t(lang, 'cta.quote')}</span>
            <span class="mt-1 block text-mute">{ar ? 'أرسل متطلباتك وسنرد عليك بعرض سعر.' : 'Send your requirement; we reply with a proposal.'}</span>
            <span class="link-arrow mt-auto pt-4">{ar ? 'أرسل طلبك' : 'Send a request'} <Icon name="arrow" size={16} flip /></span>
          </span>
        </button>
        <a href={`mailto:${cfg.contactEmail}`} class="group card flex min-h-[220px] flex-col gap-6 p-7 transition-[border-color,box-shadow] duration-200 hover:border-brand-200 hover:shadow-[var(--shadow-card)]">
          <span class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-50 text-brand-600"><Icon name="mail" size={22} /></span>
          <span class="flex flex-1 flex-col">
            <span class="display block text-2xl">{ar ? 'البريد الإلكتروني' : 'Email'}</span>
            <span class="mt-1 block text-mute"><bdi dir="ltr">{cfg.contactEmail}</bdi></span>
            <span class="link-arrow mt-auto pt-4">{ar ? 'راسلنا' : 'Write to us'} <Icon name="arrow" size={16} flip /></span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- What happens next -->
  <section class="border-t border-line py-14 md:py-20" aria-labelledby="next-h">
    <div class="wrap">
      <h2 id="next-h" class="display text-[clamp(1.6rem,3vw,2.4rem)]">{ar ? 'ماذا يحدث بعد ذلك' : 'What happens next'}</h2>
      <ol class="mt-10 grid gap-px overflow-hidden rounded-[var(--radius-md)] border border-line bg-line md:grid-cols-3">
        {next.map((n, i) => (
          <li class="bg-card p-6 md:p-7">
            <p class="label text-brand-600">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="display mt-4 text-lg">{n.h}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-mute">{n.p}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="office" class="scroll-mt-24 border-t border-line bg-card py-14 md:py-20" aria-labelledby="office-h">
    <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.6fr] lg:gap-14">
      <div>
        <p class="label text-brand-600">{t(lang, 'footer.office')}</p>
        <h2 id="office-h" class="display mt-3 text-[clamp(1.6rem,3vw,2.4rem)]">{ar ? 'زر مكتبنا' : 'Visit our office'}</h2>
        <address class="mt-5 text-[17px] not-italic leading-relaxed text-ink-soft">{site.addressLines[lang].map((line, i) => <>{i > 0 && <br />}{line}</>)}</address>
        {hours && <p class="mt-4 text-mute"><span class="label">{ar ? 'ساعات العمل' : 'Office hours'}</span><br />{hours}</p>}
        <a href={site.mapUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost mt-6 max-sm:w-full"><Icon name="pin" size={18} />{ar ? 'الاتجاهات في خرائط Google' : 'Directions in Google Maps'}</a>
        <p class="mt-6 max-w-md text-mute">{ar ? 'نخدم العملاء في الإمارات والسعودية وقطر وعُمان والكويت والبحرين وبقية الشرق الأوسط.' : 'We serve customers in the UAE, Saudi Arabia, Qatar, Oman, Kuwait, Bahrain and across the wider Middle East.'}</p>
      </div>
      <OfficeMap lang={lang} />
    </div>
  </section>
</Base>
