---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { breadcrumbLd } from '../data/schema';
import { t, localize, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === 'ar';
const L = (x: string) => localize(lang, x);
const crumbs = [{ label: ar ? 'الرئيسية' : 'Home', href: L('/') }, { label: t(lang, 'nav.contact') }];
---
<Base
  lang={lang}
  title={ar ? 'تواصل مع AlyTech Scientific | أبوظبي' : 'Contact AlyTech Scientific | Abu Dhabi, UAE'}
  description={ar ? 'تواصل مع مهندسي AlyTech Scientific عبر واتساب أو البريد الإلكتروني، أو زر مكتبنا في مصفح بأبوظبي. نرد خلال يوم عمل واحد.' : 'Reach an AlyTech Scientific engineer on WhatsApp or by email, or visit our office in Mussafah, Abu Dhabi. We reply within one working day.'}
  schema={[breadcrumbLd(crumbs, L('/contact/'))]}
>
  <section class="bg-card pt-[72px]">
    <div class="wrap py-12 md:py-16">
      <Breadcrumbs items={crumbs} />
      <h1 class="display mt-10 max-w-3xl text-[clamp(2.2rem,5vw,4rem)]">{ar ? 'تحدث مع مهندس، لا مع موظف مبيعات.' : 'Talk to an engineer, not a call centre.'}</h1>
      <p class="mt-5 max-w-xl text-[17px] text-mute">{t(lang, 'lead.sub.default')}</p>

      <div class="mt-12 grid gap-3 md:grid-cols-[1.3fr_1fr_1fr]">
        <button type="button" data-lead="whatsapp" class="group on-dark flex min-h-[220px] flex-col justify-between rounded-[var(--radius-md)] bg-night-900 p-7 text-start text-white transition-shadow duration-200 hover:shadow-[var(--shadow-pop)]">
          <span class="flex h-12 w-12 items-center justify-center rounded-full bg-whatsapp"><Icon name="whatsapp" size={24} /></span>
          <span>
            <span class="display block text-2xl">WhatsApp</span>
            <span class="mt-1 block text-white/70">{ar ? 'الطريقة الأسرع. أرسل اسم الجهاز أو صورة العيّنة.' : 'Fastest. Send the instrument name or a photo of your sample.'}</span>
            <span class="link-arrow mt-4">{ar ? 'ابدأ المحادثة' : 'Start a chat'} <Icon name="arrow" size={16} flip /></span>
          </span>
        </button>
        <button type="button" data-lead="quote" class="group card flex min-h-[220px] flex-col justify-between p-7 text-start transition-[border-color,box-shadow] duration-200 hover:border-brand-200 hover:shadow-[var(--shadow-card)]">
          <span class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-50 text-brand-600"><Icon name="arrow" size={22} flip /></span>
          <span>
            <span class="display block text-xl">{t(lang, 'cta.quote')}</span>
            <span class="mt-1 block text-mute">{ar ? 'أرسل متطلباتك وسنرد بعرض.' : 'Send your requirement; we reply with a proposal.'}</span>
          </span>
        </button>
        <a href={`mailto:${site.email}`} class="group card flex min-h-[220px] flex-col justify-between p-7 transition-[border-color,box-shadow] duration-200 hover:border-brand-200 hover:shadow-[var(--shadow-card)]">
          <span class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-50 text-brand-600"><Icon name="mail" size={22} /></span>
          <span>
            <span class="display block text-xl">{ar ? 'البريد الإلكتروني' : 'Email'}</span>
            <span class="mt-1 block text-mute" dir="ltr">{site.email}</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-line py-14 md:py-20">
    <div class="wrap grid gap-8 md:grid-cols-[1fr_1.4fr] md:items-center">
      <div>
        <p class="label text-brand-600">{t(lang, 'footer.office')}</p>
        <address class="display mt-4 text-2xl not-italic leading-snug">{site.address.street}<br />{site.address.poBox}<br />{site.address.city}, {ar ? 'الإمارات العربية المتحدة' : site.address.country}</address>
        <a href={site.mapUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost mt-6"><Icon name="pin" size={18} />{ar ? 'الاتجاهات في خرائط Google' : 'Directions in Google Maps'}</a>
      </div>
      <p class="text-mute md:max-w-md md:justify-self-end">{ar ? 'نخدم العملاء في الإمارات والسعودية وقطر وعُمان والكويت والبحرين وبقية الشرق الأوسط.' : 'We serve customers in the UAE, Saudi Arabia, Qatar, Oman, Kuwait, Bahrain and across the wider Middle East.'}</p>
    </div>
  </section>
</Base>
