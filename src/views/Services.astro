---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import Ribbon from '../components/Ribbon.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { brands } from '../data/brands';
import { brandPath } from '../data/catalog';
import { breadcrumbLd, faqLd } from '../data/schema';
import { t, localize, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === 'ar';
const L = (x: string) => localize(lang, x);
const crumbs = [{ label: ar ? 'الرئيسية' : 'Home', href: L('/') }, { label: t(lang, 'nav.services') }];

// The life of an instrument with us, in order. Wording restates the service commitments the client approved.
const steps = [
  {
    icon: 'package',
    h: { en: 'Delivery & installation', ar: 'التوريد والتركيب' },
    p: { en: 'Our engineers unpack and install the instrument at your site and connect its gases and utilities.', ar: 'يفكّ مهندسونا تغليف الجهاز ويركّبونه في موقعك ويوصلون الغازات والمرافق.' },
  },
  {
    icon: 'gauge',
    h: { en: 'Commissioning', ar: 'التشغيل والاستلام' },
    p: { en: 'We verify performance against the manufacturer’s acceptance criteria before handover.', ar: 'نتحقق من أداء الجهاز وفق معايير القبول الخاصة بالمصنّع قبل التسليم.' },
  },
  {
    icon: 'graduation',
    h: { en: 'Operator training', ar: 'تدريب المشغلين' },
    p: { en: 'Hands-on training on the method, the software and routine care, so your team runs it correctly from the first sample.', ar: 'تدريب عملي على الطريقة والبرنامج والعناية الروتينية، ليشغّل فريقك الجهاز بالشكل الصحيح من العيّنة الأولى.' },
  },
  {
    icon: 'calendar',
    h: { en: 'Preventive maintenance', ar: 'الصيانة الوقائية' },
    p: { en: 'Scheduled visits under an annual maintenance contract keep the instrument productive and your audits straightforward.', ar: 'زيارات مجدولة ضمن عقد صيانة سنوي تحافظ على إنتاجية الجهاز وتسهّل عمليات التدقيق لديك.' },
  },
  {
    icon: 'wrench',
    h: { en: 'Repairs, spares & warranty', ar: 'الإصلاح وقطع الغيار والضمان' },
    p: { en: 'Warranty claims handled locally, genuine spares through our principals and repairs coordinated to keep downtime short.', ar: 'معالجة مطالبات الضمان محلياً، وقطع غيار أصلية عبر شركائنا المصنّعين، وإصلاحات منسّقة لتقليل فترات التوقف.' },
  },
] as const;

const amc = ar
  ? ['زيارات وقائية مجدولة', 'استجابة ذات أولوية', 'قطع غيار مخططة مسبقاً', 'فحوصات الأداء والمعايرة في الموقع حيثما أمكن، وبالتنسيق مع المصنّع لما سوى ذلك']
  : ['Scheduled preventive visits', 'Priority response', 'Planned spare parts', 'Performance checks and calibration on site where possible, coordinated with the manufacturer for everything else'];

const countries = ar
  ? ['الإمارات', 'السعودية', 'قطر', 'عُمان', 'الكويت', 'البحرين']
  : ['UAE', 'Saudi Arabia', 'Qatar', 'Oman', 'Kuwait', 'Bahrain'];

const faqs = ar
  ? [
      { q: 'هل يمكنكم صيانة جهاز لم نشتره منكم؟', a: 'أخبرنا بالطراز وحالته. إذا كان ضمن العلامات التي نمثّلها، يمكننا تقديم عقد صيانة له.' },
      { q: 'ما الدول التي تغطونها؟', a: 'نخدم العملاء في الإمارات والسعودية وقطر وعُمان والكويت والبحرين وبقية الشرق الأوسط، انطلاقاً من مكتبنا في مصفح بأبوظبي.' },
      { q: 'هل تعايرون الأجهزة؟', a: 'نجري فحوصات الأداء والمعايرة للأجهزة التي يمكن معايرتها في الموقع، وننسّق مع المصنّع لما سوى ذلك.' },
      { q: 'كيف تُعالج مطالبات الضمان؟', a: 'محلياً: نشخّص العطل في الموقع وننسّق مباشرة مع المصنّع، فتتعامل مع فريق واحد في منطقتك الزمنية.' },
      { q: 'ماذا يشمل تدريب المشغلين؟', a: 'تدريباً عملياً عند التسليم على الطريقة والبرنامج والعناية الروتينية، مع جلسات تجديدية للموظفين الجدد عند الطلب.' },
    ]
  : [
      { q: 'Can you service an instrument we didn’t buy from you?', a: 'Tell us the model and its condition. If it’s one of the brands we represent, we can put it under a maintenance contract.' },
      { q: 'Which countries do you cover?', a: 'We serve customers in the UAE, Saudi Arabia, Qatar, Oman, Kuwait, Bahrain and across the wider Middle East, from our office in Mussafah, Abu Dhabi.' },
      { q: 'Do you calibrate instruments?', a: 'We carry out performance checks and calibration for the instruments where this can be done on site, and coordinate with the manufacturer for everything else.' },
      { q: 'How are warranty claims handled?', a: 'Locally: we diagnose on site and coordinate directly with the manufacturer, so you deal with one team in your time zone.' },
      { q: 'What does operator training cover?', a: 'Hands-on training at handover on the method, the software and routine care, with refresher sessions for new staff on request.' },
    ];
---
<Base
  lang={lang}
  title={ar ? 'الخدمة والدعم | التركيب والصيانة والتدريب | AlyTech' : 'Service & Support | Installation, Maintenance, Training | AlyTech'}
  description={ar ? 'تركيب وتشغيل الأجهزة المخبرية، وتدريب المشغلين، وعقود الصيانة السنوية، وخدمة الضمان، وقطع الغيار من AlyTech Scientific في أبوظبي.' : 'Installation and commissioning, operator training, annual maintenance contracts, warranty service and spares for lab instruments from AlyTech, Abu Dhabi.'}
  schema={[faqLd(faqs), breadcrumbLd(crumbs, L('/services/'))]}
>
  <section data-header="dark" class="on-dark relative overflow-hidden bg-night-950 pt-[72px] text-white">
    <Ribbon class="absolute inset-0 h-full w-full text-brand-600 opacity-35" lines={36} />
    <div class="wrap relative py-14 md:py-24">
      <Breadcrumbs items={crumbs} tone="dark" />
      <p class="label mt-10 text-brand-300">{t(lang, 'footer.iso')}</p>
      <h1 class="display mt-4 max-w-4xl text-[clamp(2.3rem,5.4vw,4.4rem)]">{ar ? 'الجهاز هو البداية فقط.' : 'The instrument is only the beginning.'}</h1>
      <p class="mt-6 max-w-2xl text-[17px] leading-relaxed text-white/75">{ar ? 'نركّب وندرّب ونصون كل جهاز نورّده، بفريق مقره أبوظبي يخدم الشرق الأوسط بأكمله.' : 'We install, train and maintain every instrument we supply, with a team based in Abu Dhabi serving the whole Middle East.'}</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap max-sm:*:w-full">
        <button type="button" class="btn btn-primary" data-lead="quote" data-product={ar ? 'طلب خدمة' : 'Service request'}>{ar ? 'اطلب زيارة صيانة' : 'Request a service visit'} <Icon name="arrow" size={18} flip /></button>
        <button type="button" class="btn btn-wa" data-lead="whatsapp" data-product={ar ? 'الخدمة والدعم' : 'Service & support'}><Icon name="whatsapp" size={18} class="text-whatsapp" />{t(lang, 'cta.whatsapp')}</button>
      </div>
    </div>
  </section>

  <!-- The life of an instrument with us -->
  <section class="py-16 md:py-24" aria-labelledby="life-h">
    <div class="wrap">
      <p class="label text-brand-600">{ar ? 'من التسليم إلى الصيانة' : 'From delivery to maintenance'}</p>
      <h2 id="life-h" class="display mt-3 max-w-3xl text-[clamp(1.7rem,3.2vw,2.6rem)] text-balance">{ar ? 'فريق واحد طوال عمر الجهاز.' : 'One team for the whole life of the instrument.'}</h2>
      <ol class="track mt-12 grid gap-0 lg:grid-cols-5 lg:gap-6">
        {steps.map((s, i) => (
          <li class="track-step relative ps-16 pb-10 last:pb-0 lg:ps-0 lg:pb-0">
            <span class="track-node absolute start-0 top-0 flex h-12 w-12 items-center justify-center rounded-full border border-brand-200 bg-card text-brand-600 lg:static">
              <Icon name={s.icon} size={22} />
            </span>
            <p class="label text-mute lg:mt-6">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="display mt-2 text-lg leading-snug">{s.h[lang]}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-mute">{s.p[lang]}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Annual maintenance contracts -->
  <section class="border-y border-line bg-card py-16 md:py-24" aria-labelledby="amc-h">
    <div class="wrap grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
      <div>
        <p class="label text-brand-600">{ar ? 'عقود الصيانة السنوية' : 'Annual maintenance contracts'}</p>
        <h2 id="amc-h" class="display mt-3 text-[clamp(1.7rem,3.2vw,2.6rem)] text-balance">{ar ? 'عقد واحد يحافظ على إنتاجية الجهاز.' : 'One contract that keeps the instrument productive.'}</h2>
        <ul class="mt-8 grid gap-3">
          {amc.map((a) => (
            <li class="flex items-start gap-3 text-[16px] text-ink-soft">
              <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-600"><Icon name="check" size={14} /></span>{a}
            </li>
          ))}
        </ul>
        <button type="button" class="btn btn-primary mt-9 max-sm:w-full" data-lead="quote" data-product={ar ? 'عقد صيانة سنوي' : 'Annual maintenance contract'}>{ar ? 'اطلب عرض سعر لعقد صيانة' : 'Ask for a maintenance quote'} <Icon name="arrow" size={18} flip /></button>
      </div>
      <div class="card self-start p-7 md:p-8">
        <span class="flex h-11 w-11 items-center justify-center rounded-sm bg-brand-50 text-brand-600"><Icon name="shield" size={22} /></span>
        <h3 class="display mt-5 text-xl">{ar ? 'هل لديك جهاز من مورد آخر؟' : 'Own an instrument bought elsewhere?'}</h3>
        <p class="mt-2 text-mute">{ar ? 'أخبرنا بالطراز والحالة. إذا كان ضمن العلامات التي نمثّلها، يمكننا تقديم عقد صيانة له.' : 'Tell us the model and its condition. If it’s one of the brands we represent, we can put it under a maintenance contract.'}</p>
        <button type="button" class="link-arrow mt-5" data-lead="interest" data-product={ar ? 'عقد صيانة سنوي' : 'Annual maintenance contract'}>{t(lang, 'cta.interest')} <Icon name="arrow" size={16} flip /></button>
      </div>
    </div>
  </section>

  <!-- Brands and coverage -->
  <section class="py-16 md:py-20" aria-label={ar ? 'العلامات ونطاق الخدمة' : 'Brands and coverage'}>
    <div class="wrap grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="display text-[clamp(1.4rem,2.6vw,2rem)]">{ar ? 'العلامات التي ندعمها' : 'Brands we support'}</h2>
        <ul class="mt-6 flex flex-wrap gap-2">
          {brands.map((b) => <li><a href={L(brandPath(b))} class="inline-flex rounded-full border border-line-strong px-3.5 py-2 text-[14px] font-medium transition-colors hover:border-brand-500 hover:text-brand-700"><bdi dir="ltr">{b.name}</bdi></a></li>)}
        </ul>
      </div>
      <div>
        <h2 class="display text-[clamp(1.4rem,2.6vw,2rem)]">{ar ? 'أين نعمل' : 'Where we work'}</h2>
        <ul class="mt-6 flex flex-wrap gap-2">
          {countries.map((c) => <li class="inline-flex items-center gap-2 rounded-full bg-surface px-3.5 py-2 text-[14px] font-medium text-ink-soft"><Icon name="pin" size={14} class="text-brand-600" />{c}</li>)}
        </ul>
        <p class="mt-4 text-mute">{ar ? 'وبقية الشرق الأوسط، انطلاقاً من مكتبنا في مصفح بأبوظبي.' : 'And across the wider Middle East, from our office in Mussafah, Abu Dhabi.'}</p>
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-card py-16 md:py-20" aria-labelledby="svc-faq-h">
    <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.6fr]">
      <h2 id="svc-faq-h" class="display text-[clamp(1.6rem,3vw,2.4rem)]">{ar ? 'أسئلة شائعة' : 'Common questions'}</h2>
      <Faq items={faqs} />
    </div>
  </section>

  <CtaBand
    lang={lang}
    title={ar ? 'هل تحتاج زيارة صيانة أو عقد صيانة؟' : 'Need a service visit or a maintenance contract?'}
    text={ar ? 'أخبرنا بالجهاز وما تحتاجه، وسيرد عليك مهندس من AlyTech.' : 'Tell us the instrument and what you need, and an AlyTech engineer will come back to you.'}
    product={ar ? 'طلب خدمة' : 'Service request'}
  />
</Base>

<style>
  /* The service track: a line joins the steps (vertical on phones and tablets, horizontal from lg) */
  .track-step::before {
    content: ""; position: absolute; inset-inline-start: 23px; top: 48px; bottom: 0; width: 1px; background: var(--color-line-strong);
  }
  .track-step:last-child::before { display: none; }
  @media (min-width: 1024px) {
    .track-step::before { inset-inline-start: 56px; inset-inline-end: -24px; top: 24px; bottom: auto; width: auto; height: 1px; }
  }
</style>
