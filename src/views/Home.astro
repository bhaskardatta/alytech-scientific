---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Icon from '../components/Icon.astro';
import Ribbon from '../components/Ribbon.astro';
import { brands, claim } from '../data/brands';
import { industries } from '../data/industries';
import { families } from '../data/equipment';
import { t, localize, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === 'ar';
const L = (p: string) => localize(lang, p);
const gasmix = brands[0];
const principals = brands.slice(1);

const lifecycle = ar
  ? [
      ['التحديد', 'يطابق مهندسو التطبيقات الجهاز مع طريقتك ومعيارك وعيّنتك قبل أن تلتزم.'],
      ['التوريد', 'التسليم إلى موقعك في أي مكان في الشرق الأوسط مع الوثائق الكاملة.'],
      ['التركيب والتشغيل', 'يركّب مهندسونا الجهاز ويشغّلونه ويتحققون من أدائه في الموقع.'],
      ['التدريب', 'تدريب المشغلين عند التسليم ليعمل فريقك بالطريقة الصحيحة من اليوم الأول.'],
      ['الصيانة', 'عقود صيانة سنوية وزيارات وقائية وخدمة الضمان.'],
      ['قطع الغيار والإصلاح', 'قطع الغيار والإصلاحات تُدار محلياً بالتنسيق مع المصنّع.'],
    ]
  : [
      ['Specify', 'Application engineers match the instrument to your method, standard and sample — before you commit.'],
      ['Supply', 'Delivered to your site anywhere in the Middle East, with complete documentation.'],
      ['Install & commission', 'Our engineers install, commission and verify performance on site.'],
      ['Train', 'Operator training at handover, so your team runs the method correctly from day one.'],
      ['Maintain', 'Annual maintenance contracts, preventive visits and warranty service.'],
      ['Spares & repairs', 'Spare parts and repairs coordinated locally with the manufacturer.'],
    ];

const title = ar
  ? 'AlyTech Scientific | أجهزة مخبرية واختبار دقيقة في الإمارات والشرق الأوسط'
  : 'AlyTech Scientific | Laboratory & Testing Instruments in the UAE and Middle East';
const description = ar
  ? 'موزع معتمد لأجهزة GasMix وThermtest وProto وDucom وInstroTek وF-DGS وSchmidt + Haensch وLamy Rheology وVinci في الشرق الأوسط، مع التركيب والتدريب والصيانة محلياً.'
  : 'Authorized Middle East distributor for GasMix, Thermtest, Proto XRD, Ducom, InstroTek, F-DGS, Schmidt + Haensch, Lamy Rheology and Vinci — with local installation, training and maintenance.';
---
<Base lang={lang} title={title} description={description}>
  <Hero lang={lang} />

  <!-- Principals -->
  <section class="py-20 md:py-28" aria-labelledby="principals-h">
    <div class="wrap">
      <div class="grid gap-6 md:grid-cols-[1fr_1fr] md:items-end">
        <div>
          <p class="label text-brand-600">{t(lang, 'nav.principals')}</p>
          <h2 id="principals-h" class="display mt-4 text-[clamp(1.9rem,3.6vw,3rem)]">{ar ? 'موزع معتمد لتسعة مصنّعين متخصصين.' : 'Authorized for nine specialist manufacturers.'}</h2>
        </div>
        <p class="max-w-md text-[17px] text-mute md:justify-self-end">{ar ? 'كل علامة أدناه نوردها ونركّبها وندعمها بمهندسي AlyTech في المنطقة.' : 'Every brand below is supplied, installed and supported by AlyTech engineers in the region.'}</p>
      </div>

      <div class="mt-12 grid gap-3 lg:grid-cols-[1.25fr_2fr]">
        <a href={L('/gasmix/')} class="group on-dark relative flex min-h-[380px] flex-col justify-between overflow-hidden rounded-[var(--radius-md)] bg-night-900 p-7 text-white transition-[transform,box-shadow] duration-300 hover:shadow-[var(--shadow-pop)] md:p-9">
          <Ribbon class="absolute inset-0 h-full w-full text-brand-500 opacity-60 transition-opacity duration-500 group-hover:opacity-90" lines={28} />
          <div class="relative flex items-start justify-between gap-4">
            <span class="label rounded-xs border border-brand-300/40 px-2.5 py-1.5 text-brand-300">{claim(gasmix)[lang]}</span>
            <span class="label text-white/50">{gasmix.country[lang]}</span>
          </div>
          <div class="relative">
            <p class="display text-[clamp(2.4rem,4.5vw,3.6rem)]">GasMix™</p>
            <p class="mt-3 max-w-sm text-white/75">{ar ? 'أجهزة خلط وتخفيف الغازات من شركتنا الأم AlyTech فرنسا — Aiolos III وZephyr II وHurricane وNomad وGRack وNephos وAURA II وبرنامج AlySoft.' : 'Gas mixers and diluters from our parent company, AlyTech France — Aiolos III, Zephyr II, Hurricane, Nomad, GRack, Nephos, AURA II and AlySoft.'}</p>
            <span class="link-arrow mt-6">{ar ? 'استكشف GasMix' : 'Explore GasMix'} <Icon name="arrow" size={18} flip /></span>
          </div>
        </a>

        <ul class="grid gap-3 sm:grid-cols-2">
          {principals.map((b) => (
            <li>
              <a href={L(`/principals/${b.slug}/`)} class="group card flex h-full flex-col justify-between gap-6 p-6 transition-[border-color,box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-[var(--shadow-card)]">
                <div class="flex items-start justify-between gap-3">
                  <p class="display text-[22px]">{b.name}</p>
                  <Icon name="arrow" size={20} flip class="mt-1 shrink-0 text-mute transition-[color,transform] duration-200 group-hover:translate-x-1 group-hover:text-brand-600 rtl:group-hover:-translate-x-1" />
                </div>
                <div>
                  <p class="text-[15px] text-ink-soft">{b.discipline[lang]}</p>
                  <p class="label mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-mute">
                    <span class={b.exclusive ? 'text-brand-600' : ''}>{claim(b)[lang]}</span>
                    <span aria-hidden="true">·</span>
                    <span>{b.country[lang]}</span>
                  </p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>


  <!-- Lab & test equipment (unbranded) -->
  <section class="pb-20 md:pb-28" aria-labelledby="equip-h">
    <div class="wrap">
      <div class="grid gap-6 border-t border-line pt-16 md:grid-cols-[1fr_1fr] md:items-end md:pt-20">
        <div>
          <p class="label text-brand-600">{t(lang, 'nav.equipment')}</p>
          <h2 id="equip-h" class="display mt-4 text-[clamp(1.9rem,3.6vw,3rem)]">{ar ? 'وكل ما يحتاجه المختبر أيضاً.' : 'And everything else the lab needs.'}</h2>
        </div>
        <p class="max-w-md text-[17px] text-mute md:justify-self-end">{ar ? 'غرف بيئية وآلات اختبار ومعدات للخرسانة والتربة والأسفلت والطلاءات والتغليف — نحددها حسب المعيار ونوردها ونركّبها.' : 'Environmental chambers, testing machines, concrete, soil, asphalt, coatings and packaging equipment — specified to your standard, supplied and installed.'}</p>
      </div>
      <ul class="mt-12 grid gap-px overflow-hidden rounded-[var(--radius-md)] border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
        {families.map((f) => (
          <li class="bg-surface">
            <a href={L(`/equipment/#${f.slug}`)} class="group flex h-full flex-col gap-3 p-6 transition-colors duration-200 hover:bg-card">
              <span class="flex items-center justify-between gap-3">
                <span class="display text-lg">{(ar && f.ar?.name) || f.name}</span>
                <Icon name="arrow" size={18} flip class="text-mute transition-[color,transform] duration-200 group-hover:translate-x-1 group-hover:text-brand-600 rtl:group-hover:-translate-x-1" />
              </span>
              <span class="text-[14px] text-mute">{f.categories.slice(0, 3).map((c) => (ar && c.ar?.name) || c.name).join(' · ')}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Service lifecycle -->
  <section class="border-y border-line bg-card py-20 md:py-28" aria-labelledby="service-h">
    <div class="wrap grid gap-14 lg:grid-cols-[1fr_1.6fr]">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="label text-brand-600">{t(lang, 'nav.services')}</p>
        <h2 id="service-h" class="display mt-4 text-[clamp(1.9rem,3.6vw,3rem)]">{ar ? 'لا نكتفي بالشحن. نحن نشغّل الجهاز.' : 'We don’t drop-ship. We commission.'}</h2>
        <p class="mt-5 max-w-md text-[17px] text-mute">{ar ? 'يبدأ العمل الحقيقي بعد وصول الجهاز. فريقنا في أبوظبي يبقى معك طوال عمر الجهاز.' : 'The real work starts when the crate arrives. Our Abu Dhabi team stays with the instrument for its whole working life.'}</p>
        <p class="label mt-8 inline-flex items-center gap-2 rounded-xs border border-line-strong px-3 py-2 text-ink-soft"><Icon name="shield" size={16} />{t(lang, 'footer.iso')}</p>
      </div>
      <ol class="grid gap-px overflow-hidden rounded-[var(--radius-md)] border border-line bg-line sm:grid-cols-2">
        {lifecycle.map(([h, p], i) => (
          <li class="bg-card p-7">
            <p class="label text-brand-600">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="display mt-6 text-xl">{h}</h3>
            <p class="mt-2 text-[15px] text-mute">{p}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Industries -->
  <section class="py-20 md:py-28" aria-labelledby="ind-h">
    <div class="wrap">
      <p class="label text-brand-600">{t(lang, 'nav.industries')}</p>
      <h2 id="ind-h" class="display mt-4 max-w-2xl text-[clamp(1.9rem,3.6vw,3rem)]">{ar ? 'حيث تُستخدم أجهزتنا في المنطقة.' : 'Where our instruments work across the region.'}</h2>
      <ul class="mt-12 grid border-t border-line md:grid-cols-3">
        {industries.map((ind) => (
          <li class="border-b border-line md:[&:not(:nth-child(3n))]:border-e">
            <a href={L(`/industries/${ind.slug}/`)} class="group flex h-full flex-col gap-2 p-6 transition-colors duration-200 hover:bg-card md:p-7">
              <span class="flex items-center justify-between gap-3">
                <span class="display text-lg">{ind.name[lang]}</span>
                <Icon name="arrow" size={18} flip class="text-mute transition-[color,transform] duration-200 group-hover:translate-x-1 group-hover:text-brand-600 rtl:group-hover:-translate-x-1" />
              </span>
              <span class="text-[15px] text-mute">{ind.line[lang]}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Closing CTA + search -->
  <section data-header="dark" class="on-dark relative overflow-hidden bg-night-900 py-20 text-white md:py-28" aria-labelledby="cta-h">
    <Ribbon class="absolute inset-0 h-full w-full text-brand-500 opacity-40" lines={40} />
    <div class="wrap relative">
      <h2 id="cta-h" class="display max-w-3xl text-[clamp(2rem,4.4vw,3.6rem)]">{ar ? 'أخبرنا بما تريد قياسه.' : 'Tell us what you need to measure.'}</h2>
      <p class="mt-5 max-w-xl text-[17px] text-white/75">{ar ? 'أرسل الطريقة أو المعيار أو نوع العيّنة، وسيعود إليك مهندس من AlyTech بالجهاز المناسب وعرض السعر.' : 'Send the method, the standard or the sample — an AlyTech engineer will come back with the right instrument and a quotation.'}</p>
      <form action={L('/search/')} method="get" role="search" class="mt-10 flex max-w-2xl flex-col gap-3 sm:flex-row">
        <label for="home-q" class="sr-only">{t(lang, 'nav.search')}</label>
        <div class="relative flex-1">
          <Icon name="search" size={20} class="pointer-events-none absolute start-4 top-1/2 -translate-y-1/2 text-white/50" />
          <input id="home-q" name="q" type="search" class="h-14 w-full rounded-sm border border-white/20 bg-white/5 ps-12 pe-4 text-[16px] text-white placeholder:text-white/45 transition-colors hover:border-white/40 focus:border-brand-300 focus:outline-none" placeholder={ar ? 'مثال: مقياس الموصلية الحرارية، غرفة رطوبة، ASTM D5334' : 'e.g. thermal conductivity meter, humidity chamber, ASTM D5334'} />
        </div>
        <button class="btn btn-primary h-14">{ar ? 'بحث' : 'Search'}</button>
      </form>
      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 text-white/70">
        <button type="button" class="link-arrow" data-lead="whatsapp"><Icon name="whatsapp" size={18} />{t(lang, 'cta.whatsapp')}</button>
        <button type="button" class="link-arrow" data-lead="quote">{t(lang, 'cta.quote')} <Icon name="arrow" size={16} flip /></button>
      </div>
    </div>
  </section>
</Base>
