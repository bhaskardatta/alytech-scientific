---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Icon from '../components/Icon.astro';
import Ribbon from '../components/Ribbon.astro';
import { brands, claim, origin } from '../data/brands';
import { industries } from '../data/industries';
import { industryContent } from '../data/industryContent';
import { productsOf, imageOf, productPath, brandPath, shortName } from '../data/catalog';
import ProductImage from '../components/ProductImage.astro';
import { families, renderOf } from '../data/equipment';
import { ltr } from '../lib/bidi';
import { t, localize, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === 'ar';
const L = (p: string) => localize(lang, p);
// Homepage sections kept in the code but not shown for now (owner's request, Oct 2026). Set to true to bring one back.
const showEquipment = false;
const showIndustries = false;
// GasMix and the other principals are two separate sections (owner's request, Oct 2026): GasMix never sits in the
// principals grid, and every principal gets the same tile so none reads as favoured.
const gasmix = brands[0];
const principals = brands.slice(1);

// GasMix range, smallest to largest. Facts as in the comparison table on /gasmix/.
const gasmixBySlug = new Map(productsOf('gasmix').map((p) => [p.slug, p]));
const range = [
  ['zephyr-ii', '2 channels · bench or field', 'قناتان · للمختبر أو الميدان'],
  ['nomad', '2–4 channels · portable case', '2–4 قنوات · حقيبة محمولة'],
  ['aiolos-iii', '2–6 channels · modular lab', '2–6 قنوات · مخبري معياري'],
  ['grack', '2–6 channels · 19″ rack', '2–6 قنوات · رف 19″'],
  ['hurricane', '7–16 channels · custom to 20', '7–16 قناة · حتى 20 حسب الطلب'],
  ['nephos', 'Liquid-to-gas standards', 'معايير من سائل إلى غاز'],
].flatMap(([slug, en, arLine]) => { const p = gasmixBySlug.get(slug); return p ? [{ p, line: ar ? arLine : en }] : []; });

// [label, heading, text]. Every figure is from the GasMix catalog (ISO 6145-7, MFC calibration, AlySoft certificate).
const pillars = ar
  ? [
      ['الخلط', 'مزج حتى 16 غازاً', 'وحدة تحكم بالتدفق الكتلي لكل قناة، من مخففات بقناتين حتى منصات بـ 16 قناة، وحتى 20 قناة حسب الطلب.'],
      ['التخفيف', 'من النسب المئوية حتى ppb', 'تخفيف حتى 1:10,000 كمعيار، وحتى 10⁸ مع خيار Cascade.'],
      ['تحضير المعايير', 'معايير من السوائل', 'يحوّل Nephos السوائل النقية — المركبات العضوية المتطايرة والكحولات والسيلوكسانات والماء — إلى معايير غازية لا توفّرها الأسطوانات.'],
      ['الامتثال', 'جاهز للتدقيق', 'طريقة ISO 6145-7 الديناميكية، ومعايرة مصنعية من 400 نقطة قابلة للتتبع إلى NIST، وشهادة وسجل تدقيق من AlySoft لكل تسلسل.'],
    ]
  : [
      ['Mixing', 'Blend up to 16 gases', 'A mass flow controller on every channel, from two-channel diluters to 16-channel benches — custom builds go to 20.'],
      ['Dilution', 'Percent levels to ppb', 'Dilution up to 1:10,000 as standard, and up to 10⁸ with the Cascade option.'],
      ['Standard preparation', 'Standards from liquids', 'Nephos turns pure liquids — VOCs, alcohols, siloxanes, water — into gas-phase standards that cylinders can’t supply.'],
      ['Compliance', 'Ready for the audit', 'ISO 6145-7 dynamic method, 400-point NIST-traceable MFC calibration, and an AlySoft certificate and audit trail for every sequence.'],
    ];

// Each principal's tile pictures its lead instrument (flagship first).
const leadOf = (slug: string) => productsOf(slug).find((p) => imageOf(slug, p.slug));

// Industries: each card shows a real instrument we supply for that sector (manufacturer photo, a different one per card),
// how many of our instruments serve it and the brands behind them.
// Neighbouring cards picture different brands where the sector allows, so no two cards look alike.
const used = new Set<string>();
let lastBrand = '';
const short = (name: string) => name.replace(/ (Instruments|Technologies)$/, '');
const sectors = industries.map((ind) => {
  const featured = (industryContent[ind.slug]?.brands ?? []).map((s) => brands.find((b) => b.slug === s)!).filter(Boolean);
  const tagged = brands.flatMap((b) => productsOf(b.slug).filter((p) => p.industries?.includes(ind.slug)));
  const options = featured
    .flatMap((b) => productsOf(b.slug).filter((p) => p.industries?.includes(ind.slug) && imageOf(b.slug, p.slug)).sort((x, y) => Number(y.priority === 'flagship') - Number(x.priority === 'flagship')).map((p) => ({ b, p })))
    .filter(({ b, p }) => !used.has(`${b.slug}/${p.slug}`));
  const pick = options.find(({ b }) => b.slug !== lastBrand) ?? options[0];
  if (pick) { used.add(`${pick.b.slug}/${pick.p.slug}`); lastBrand = pick.b.slug; }
  return { ind, pick, count: tagged.length, names: featured.slice(0, 3).map((b) => short(b.name)) };
});

const lifecycle = ar
  ? [
      ['التحديد', 'يطابق مهندسو التطبيقات الجهاز مع طريقتك ومعيارك وعيّنتك قبل أن تلتزم.'],
      ['التوريد', 'التسليم إلى موقعك في أي مكان في الشرق الأوسط مع الوثائق الكاملة.'],
      ['التركيب والتشغيل', 'يركّب مهندسونا الجهاز ويشغّلونه ويتحققون من أدائه في الموقع.'],
      ['التدريب', 'تدريب المشغلين عند التسليم ليعمل فريقك بالطريقة الصحيحة من اليوم الأول.'],
      ['الصيانة', 'عقود صيانة سنوية وزيارات وقائية وخدمة الضمان.'],
      ['قطع الغيار والإصلاح', 'قطع الغيار والإصلاحات تُدار محلياً بالتنسيق مع المصنّع.'],
    ]
  : [
      ['Specify', 'Application engineers match the instrument to your method, standard and sample — before you commit.'],
      ['Supply', 'Delivered to your site anywhere in the Middle East, with complete documentation.'],
      ['Install & commission', 'Our engineers install, commission and verify performance on site.'],
      ['Train', 'Operator training at handover, so your team runs the method correctly from day one.'],
      ['Maintain', 'Annual maintenance contracts, preventive visits and warranty service.'],
      ['Spares & repairs', 'Spare parts and repairs coordinated locally with the manufacturer.'],
    ];

const title = ar ? 'AlyTech Scientific | أجهزة المختبرات في الإمارات' : 'AlyTech Scientific | Laboratory Instruments in the UAE';
const description = ar
  ? 'أجهزة المختبرات والاختبار من GasMix وThermtest وProto XRD وDucom وInstroTek وF-DGS وSchmidt + Haensch وLamy Rheology وVinci، بدعم في جميع أنحاء الشرق الأوسط.'
  : 'Lab and test instruments from GasMix, Thermtest, Proto XRD, Ducom, InstroTek, F-DGS, Schmidt + Haensch, Lamy Rheology and Vinci, supported in the Middle East.';
---
<Base lang={lang} title={title} description={description}>
  <Hero lang={lang} />

  <!-- GasMix: a section of its own, before (and visually above) the principals -->
  <section id="gasmix" data-header="dark" class="on-dark relative overflow-hidden border-t border-white/10 bg-night-900 py-20 text-white md:py-28" aria-labelledby="gasmix-h">
    <Ribbon class="absolute inset-0 h-full w-full text-brand-500 opacity-35" lines={36} />
    <div class="wrap relative">
      <div class="grid gap-8 md:grid-cols-[1fr_1fr] md:items-end">
        <div>
          <p class="label inline-block rounded-xs border border-brand-300/40 px-2.5 py-1.5 text-balance text-brand-300">{claim(gasmix)[lang]}</p>
          <h2 id="gasmix-h" class="display mt-6 text-[clamp(3rem,7vw,5.5rem)] leading-none"><bdi dir="ltr">GasMix™</bdi></h2>
          <p class="label mt-4 text-white/55">{origin(gasmix)[lang]}</p>
        </div>
        <div class="max-w-md md:justify-self-end">
          <p class="display text-[clamp(1.35rem,2.2vw,1.75rem)]">{ar ? 'غاز المعايرة، يُحضَّر في موقعك.' : 'Calibration gas, made on site.'}</p>
          <p class="mt-3 text-[17px] text-white/75" set:html={ltr(ar ? 'أجهزة خلط وتخفيف الغازات من تصميم وتصنيع AlyTech في فرنسا. تولّد المزيج الذي يحتاجه محللك بالضبط — من النسب المئوية حتى أجزاء في البليون — بدلاً من أسطوانة لكل تركيز.' : 'Gas mixers and diluters designed and built by AlyTech in France. They generate the exact mixture your analyzer needs — from percent levels down to ppb — instead of a cylinder for every concentration.', lang)} />
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap max-sm:*:w-full">
            <a href={L('/gasmix/')} class="btn btn-primary">{ar ? 'استكشف GasMix' : 'Explore GasMix'} <Icon name="arrow" size={18} flip /></a>
            <button type="button" class="btn btn-wa" data-lead="whatsapp" data-brand="GasMix" data-product="GasMix"><Icon name="whatsapp" size={18} class="text-whatsapp" />{t(lang, 'cta.whatsapp')}</button>
          </div>
        </div>
      </div>

      <ol class="mt-14 grid gap-px overflow-hidden rounded-[var(--radius-md)] border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-4">
        {pillars.map(([k, h, p], i) => (
          <li class="bg-night-900 p-6 md:p-7">
            <p class="label text-brand-300">{String(i + 1).padStart(2, '0')} · {k}</p>
            <h3 class="display mt-5 text-xl" set:html={ltr(h, lang)} />
            <p class="mt-2 text-[15px] text-white/70" set:html={ltr(p, lang)} />
          </li>
        ))}
      </ol>

      <div class="mt-14 flex items-baseline justify-between gap-4">
        <h3 class="label text-white/60">{ar ? 'المجموعة' : 'The range'}</h3>
        <a href={L('/gasmix/')} class="link-arrow text-sm">{ar ? 'كل منتجات GasMix' : 'All GasMix products'} <Icon name="arrow" size={16} flip /></a>
      </div>
      {/* Phones: a swipeable rail; tablets: 3 across; desktop: the whole range in one row */}
      <ul class="-mx-4 mt-5 flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-px-4 px-4 pb-2 md:mx-0 md:grid md:snap-none md:grid-cols-3 md:overflow-visible md:px-0 md:pb-0 lg:grid-cols-6">
        {range.map(({ p, line }) => (
          <li class="w-[44%] shrink-0 snap-start md:w-auto">
            <a href={L(productPath(gasmix, p))} class="group flex h-full flex-col overflow-hidden rounded-[var(--radius-md)] border border-white/10 bg-night-800/60 transition-[border-color,transform] duration-200 hover:-translate-y-0.5 hover:border-brand-300/40">
              <span class="relative block aspect-[4/3] bg-surface">
                <ProductImage brand="gasmix" brandName="GasMix" slug={p.slug} alt="" decorative class="absolute inset-0 h-full w-full p-4 transition-transform duration-500 group-hover:scale-[1.04]" sizes="(min-width: 1024px) 16vw, (min-width: 768px) 30vw, 44vw" />
              </span>
              <span class="flex flex-1 flex-col gap-1 p-4">
                <span class="display text-[17px]" set:html={ltr(shortName(p, lang), lang)} />
                <span class="text-[13.5px] leading-snug text-white/65" set:html={ltr(line, lang)} />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Principals: one identical tile per brand -->
  <section class="py-20 md:py-28" aria-labelledby="principals-h">
    <div class="wrap">
      <div class="grid gap-6 md:grid-cols-[1fr_1fr] md:items-end">
        <div>
          <p class="label text-brand-600">{t(lang, 'nav.principals')}</p>
          <h2 id="principals-h" class="display mt-4 text-[clamp(1.9rem,3.6vw,3rem)]">{ar ? 'مصنّعون متخصصون نمثّلهم.' : 'Specialist manufacturers we represent.'}</h2>
        </div>
        <p class="max-w-md text-[17px] text-mute md:justify-self-end">{ar ? 'كل علامة أدناه نوردها ونركّبها وندعمها بمهندسي AlyTech في المنطقة.' : 'Every brand below is supplied, installed and supported by AlyTech engineers in the region.'}</p>
      </div>

      <ul class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {principals.map((b) => {
          const p = leadOf(b.slug);
          return (
            <li>
              <a href={L(brandPath(b))} class="group card flex h-full flex-col overflow-hidden transition-[border-color,box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-[var(--shadow-card)]">
                <span class:list={['relative block aspect-[4/3] overflow-hidden', p && imageOf(b.slug, p.slug)?.dark ? 'bg-[#242424]' : 'bg-surface']}>
                  {p && <ProductImage brand={b.slug} brandName={b.name} slug={p.slug} alt="" decorative class="absolute inset-0 h-full w-full p-6 transition-transform duration-500 group-hover:scale-[1.03]" sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 90vw" />}
                </span>
                <span class="flex flex-1 flex-col gap-4 p-5 md:p-6">
                  <span class="flex items-start justify-between gap-3">
                    <span>
                      <span class="display block text-[22px]">{b.name}</span>
                      <span class="label mt-1.5 block text-mute">{origin(b)[lang]}</span>
                    </span>
                    <Icon name="arrow" size={20} flip class="mt-1 shrink-0 text-mute transition-[color,transform] duration-200 group-hover:translate-x-1 group-hover:text-brand-600 rtl:group-hover:-translate-x-1" />
                  </span>
                  <span class="text-[15px] text-ink-soft">{b.discipline[lang]}</span>
                  <span class:list={['label mt-auto', b.exclusive ? 'text-brand-600' : 'text-mute']}>{claim(b)[lang]}</span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>


  {/* Lab & test equipment (unbranded): hidden for now, see showEquipment */}
  {showEquipment && (
  <section class="pb-20 md:pb-28" aria-labelledby="equip-h">
    <div class="wrap">
      <div class="grid gap-6 border-t border-line pt-16 md:grid-cols-[1fr_1fr] md:items-end md:pt-20">
        <div>
          <p class="label text-brand-600">{t(lang, 'nav.equipment')}</p>
          <h2 id="equip-h" class="display mt-4 text-[clamp(1.9rem,3.6vw,3rem)]">{ar ? 'وكل ما يحتاجه المختبر أيضاً.' : 'And everything else the lab needs.'}</h2>
        </div>
        <p class="max-w-md text-[17px] text-mute md:justify-self-end">{ar ? 'غرف بيئية وآلات اختبار ومعدات للخرسانة والتربة والأسفلت والطلاءات والتغليف — نحددها حسب المعيار ونوردها ونركّبها.' : 'Environmental chambers, testing machines, concrete, soil, asphalt, coatings and packaging equipment — specified to your standard, supplied and installed.'}</p>
      </div>
      <ul class="mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-[var(--radius-md)] border border-line bg-line lg:grid-cols-3">
        {families.map((f) => (
          <li class="bg-surface">
            <a href={L(`/equipment/#${f.slug}`)} class="group flex h-full flex-col gap-3 p-4 transition-colors duration-200 hover:bg-card focus-visible:outline-offset-[-3px] sm:p-6">
              {(() => { const r = f.categories.map((c) => renderOf(c.slug)).find(Boolean); return r && <img src={r.sm} width={r.w} height={r.h} alt="" loading="lazy" decoding="async" class="mb-2 aspect-[4/3] w-full rounded-xs object-cover transition-transform duration-500 group-hover:scale-[1.02]" />; })()}
              <span class="flex items-center justify-between gap-3">
                <span class="display text-[15px] leading-snug sm:text-lg">{(ar && f.ar?.name) || f.name}</span>
                <Icon name="arrow" size={18} flip class="shrink-0 text-mute transition-[color,transform] duration-200 group-hover:translate-x-1 group-hover:text-brand-600 rtl:group-hover:-translate-x-1" />
              </span>
              <span class="hidden text-[14px] text-mute sm:block">{f.categories.slice(0, 3).map((c) => (ar && c.ar?.name) || c.name).join(' · ')}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  )}

  <!-- Service lifecycle -->
  <section class="border-y border-line bg-card py-20 md:py-28" aria-labelledby="service-h">
    <div class="wrap grid gap-14 lg:grid-cols-[1fr_1.6fr]">
      <div class="@container lg:sticky lg:top-28 lg:self-start">
        <p class="label text-brand-600">{t(lang, 'nav.services')}</p>
        {/* Each sentence stays on one line (owner's request): the size follows the column width (10cqi ≈ the widest sentence). */}
        <h2 id="service-h" class="display mt-4 text-[clamp(1.75rem,10cqi,3rem)]">{ar ? 'لا نكتفي بالشحن.' : <>We don’t <span class="whitespace-nowrap">drop-ship.</span></>}<br />{ar ? 'نحن نشغّل الجهاز.' : 'We commission.'}</h2>
        <p class="mt-5 max-w-md text-[17px] text-mute">{ar ? 'يبدأ العمل الحقيقي بعد وصول الجهاز. فريقنا في أبوظبي يبقى معك طوال عمر الجهاز.' : 'The real work starts when the crate arrives. Our Abu Dhabi team stays with the instrument for its whole working life.'}</p>
        <p class="label mt-8 inline-flex items-center gap-2 rounded-xs border border-line-strong px-3 py-2 text-ink-soft"><Icon name="shield" size={16} />{t(lang, 'footer.iso')}</p>
      </div>
      <ol class="grid gap-px overflow-hidden rounded-[var(--radius-md)] border border-line bg-line sm:grid-cols-2">
        {lifecycle.map(([h, p], i) => (
          <li class="bg-card p-7">
            <p class="label text-brand-600">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="display mt-6 text-xl">{h}</h3>
            <p class="mt-2 text-[15px] text-mute">{p}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* Industries: hidden for now, see showIndustries */}
  {showIndustries && (
  <section class="py-20 md:py-28" aria-labelledby="ind-h">
    <div class="wrap">
      <p class="label text-brand-600">{t(lang, 'nav.industries')}</p>
      <h2 id="ind-h" class="display mt-4 max-w-2xl text-[clamp(1.9rem,3.6vw,3rem)]">{ar ? 'حيث تُستخدم أجهزتنا في المنطقة.' : 'Where our instruments work across the region.'}</h2>
      {/* Phones: a swipeable rail (the next card peeks in); tablets and up: a grid */}
      <ul class="-mx-4 mt-12 flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-px-4 px-4 pb-2 md:mx-0 md:grid md:snap-none md:grid-cols-2 md:overflow-visible md:px-0 md:pb-0 lg:grid-cols-3">
        {sectors.map(({ ind, pick, count, names }) => (
          <li class="w-[82%] shrink-0 snap-start md:w-auto">
            <a href={L(`/industries/${ind.slug}/`)} class="group card flex h-full flex-col overflow-hidden transition-[border-color,box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-[var(--shadow-card)]">
              <div class="sector-stage relative aspect-[16/10] overflow-hidden bg-surface">
                <div class="sector-grid absolute inset-0" aria-hidden="true"></div>
                {pick && <ProductImage brand={pick.b.slug} brandName={pick.b.name} slug={pick.p.slug} alt="" decorative class="absolute inset-0 h-full w-full p-6 transition-transform duration-500 group-hover:scale-[1.04]" sizes="(min-width: 1024px) 30vw, (min-width: 768px) 45vw, 80vw" />}
              </div>
              <div class="flex flex-1 flex-col gap-2 p-5 md:p-6">
                <span class="flex items-center justify-between gap-3">
                  <span class="display text-lg">{ind.name[lang]}</span>
                  <Icon name="arrow" size={18} flip class="shrink-0 text-mute transition-[color,transform] duration-200 group-hover:translate-x-1 group-hover:text-brand-600 rtl:group-hover:-translate-x-1" />
                </span>
                <span class="text-[15px] leading-relaxed text-mute">{ind.line[lang]}</span>
                <span class="label mt-auto pt-3 text-ink-soft">{ar ? `${count} ${count >= 3 && count <= 10 ? 'أجهزة' : 'جهازاً'}` : `${count} instruments`} · <bdi dir="ltr">{names.join(', ')}</bdi></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  )}

  <!-- Closing CTA + search -->
  <section data-header="dark" class="on-dark relative overflow-hidden bg-night-900 py-20 text-white md:py-28" aria-labelledby="cta-h">
    <Ribbon class="absolute inset-0 h-full w-full text-brand-500 opacity-40" lines={40} />
    <div class="wrap relative">
      <h2 id="cta-h" class="display max-w-3xl text-[clamp(2rem,4.4vw,3.6rem)]">{ar ? 'أخبرنا بما تريد قياسه.' : 'Tell us what you need to measure.'}</h2>
      <p class="mt-5 max-w-xl text-[17px] text-white/75">{ar ? 'أرسل الطريقة أو المعيار أو نوع العيّنة، وسيعود إليك مهندس من AlyTech بالجهاز المناسب وعرض السعر.' : 'Send the method, the standard or the sample — an AlyTech engineer will come back with the right instrument and a quotation.'}</p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap max-sm:*:w-full">
        <button type="button" class="btn btn-primary" data-lead="quote">{t(lang, 'cta.quote')} <Icon name="arrow" size={18} flip /></button>
        <button type="button" class="btn btn-wa" data-lead="whatsapp"><Icon name="whatsapp" size={18} class="text-whatsapp" />{t(lang, 'cta.whatsapp')}</button>
      </div>
      <form action={L('/search/')} method="get" role="search" class="mt-10 max-w-2xl border-t border-white/10 pt-8">
        <label for="home-q" class="label text-white/60">{ar ? 'أو ابحث في الكتالوج' : 'Or search the catalog'}</label>
        <div class="mt-3 flex flex-col gap-3 sm:flex-row">
          <div class="relative flex-1">
            <Icon name="search" size={20} class="pointer-events-none absolute start-4 top-1/2 -translate-y-1/2 text-white/50" />
            <input id="home-q" name="q" type="search" class="h-14 w-full rounded-sm border border-white/45 bg-white/5 ps-12 pe-4 text-[16px] text-white placeholder:text-white/45 transition-colors hover:border-white/40 focus:border-brand-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-300" placeholder={ar ? 'مثال: مقياس الموصلية الحرارية، غرفة رطوبة، ASTM D5334' : 'e.g. thermal conductivity meter, humidity chamber, ASTM D5334'} />
          </div>
