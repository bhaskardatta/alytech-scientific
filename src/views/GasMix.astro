---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductImage from '../components/ProductImage.astro';
import ServiceStrip from '../components/ServiceStrip.astro';
import Ribbon from '../components/Ribbon.astro';
import Icon from '../components/Icon.astro';
import { brands, claim } from '../data/brands';
import { productsOf, productPath } from '../data/catalog';
import { breadcrumbLd } from '../data/schema';
import { t, localize, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === 'ar';
const L = (x: string) => localize(lang, x);
const brand = brands[0];
const all = productsOf('gasmix');
const instruments = all.filter((p) => p.priority !== 'niche');
const accessories = all.filter((p) => p.priority === 'niche');
const crumbs = [{ label: ar ? 'الرئيسية' : 'Home', href: L('/') }, { label: 'GasMix' }];

// Verified against gasmix.com product pages (Oct 2026). Order = smallest to largest.
const compare = [
  { slug: 'zephyr-ii', ch: '2', dil: '1:10 000', fmt: { en: 'Compact bench / field, optional battery', ar: 'مدمج للمختبر والميدان، بطارية اختيارية' }, ctl: { en: '7″ touchscreen, embedded AlySoft', ar: 'شاشة لمس 7″ وبرنامج AlySoft مدمج' } },
  { slug: 'nomad', ch: '2–4', dil: '1:10 000', fmt: { en: 'Portable carry case', ar: 'حقيبة محمولة' }, ctl: { en: 'Built-in industrial PC or external PC', ar: 'حاسوب صناعي مدمج أو خارجي' } },
  { slug: 'aiolos-iii', ch: '2–6', dil: '10⁴ · 10⁸ with Cascade', fmt: { en: 'Modular laboratory', ar: 'مخبري معياري' }, ctl: { en: 'AlySoft on PC via Ethernet', ar: 'AlySoft على حاسوب عبر إيثرنت' } },
  { slug: 'grack', ch: '2–6', dil: '1:10 000', fmt: { en: '19″ rack (GMRack adds touchscreen)', ar: 'رف 19″ (GMRack مع شاشة لمس)' }, ctl: { en: 'AlySoft on PC; PLC/DCS I/O', ar: 'AlySoft على حاسوب؛ مداخل PLC/DCS' } },
  { slug: 'hurricane', ch: '7–16', dil: '—', fmt: { en: 'High-channel laboratory (custom to 20)', ar: 'مخبري متعدد القنوات (حتى 20 حسب الطلب)' }, ctl: { en: 'GasMix PC software', ar: 'برنامج GasMix على حاسوب' } },
  { slug: 'nephos', ch: '1–2 liquid + 1–4 gas', dil: '10⁴ · 10⁸ with Cascade', fmt: { en: 'Liquid-to-gas generator', ar: 'مولّد من السائل إلى الغاز' }, ctl: { en: 'AlySoft on PC via Ethernet', ar: 'AlySoft على حاسوب عبر إيثرنت' } },
];
const bySlug = new Map(all.map((p) => [p.slug, p]));

const common = ar
  ? ['دقة التدفق ±1 % من القيمة المضبوطة', 'تكرارية أقل من 0.1 %', 'معايرة مصنعية من 400 نقطة قابلة للتتبع إلى NIST', 'مسارات من الفولاذ المقاوم 316 بطلاء خامل']
  : ['±1 % of setpoint flow accuracy', '< 0.1 % repeatability', '400-point factory MFC calibration, NIST-traceable', '316 stainless wetted paths with inert coating'];

const title = ar ? 'GasMix | أجهزة خلط وتخفيف الغازات للمعايرة في الإمارات والشرق الأوسط | AlyTech' : 'GasMix Gas Mixers & Gas Diluters | Calibration Gas Generation in the UAE & Middle East | AlyTech';
const description = ar
  ? 'موزع GasMix الحصري في الشرق الأوسط: Aiolos III وZephyr II وNomad وGRack وHurricane وNephos وAURA II. توليد غازات المعايرة في موقعك بدلاً من الأسطوانات.'
  : 'Exclusive Middle East distributor of GasMix gas mixers and diluters — Aiolos III, Zephyr II, Nomad, GRack, Hurricane, Nephos and AURA II. Generate calibration gas on site instead of buying cylinders.';
---
<Base lang={lang} title={title} description={description} schema={[breadcrumbLd(crumbs, L('/gasmix/'))]}>
  <section data-header="dark" class="on-dark relative overflow-hidden bg-night-950 pt-[72px] text-white">
    <Ribbon class="absolute inset-0 h-full w-full text-brand-600 opacity-45" lines={44} />
    <div class="wrap relative grid gap-10 py-12 md:py-20 lg:grid-cols-[1.1fr_1fr] lg:items-center">
      <div>
        <Breadcrumbs items={crumbs} tone="dark" />
        <p class="label mt-10 text-brand-300">{claim(brand)[lang]}</p>
        <h1 class="display mt-4 text-[clamp(2.4rem,5.6vw,4.6rem)]">{ar ? 'أجهزة GasMix™ لخلط الغازات وتخفيفها' : 'GasMix™ gas mixers & diluters'}</h1>
        <p class="mt-6 max-w-xl text-[17px] leading-relaxed text-white/75">{ar ? 'صممتها وصنعتها شركتنا الأم AlyTech في فرنسا. تولّد معايير المعايرة في موقعك — من النسب المئوية حتى أجزاء في البليون — بدلاً من شراء أسطوانة لكل تركيز.' : 'Designed and assembled by our parent company, AlyTech, in Juvisy-sur-Orge, France. Generate calibration standards on site — from percent levels down to ppb — instead of buying a cylinder for every concentration.'}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <button type="button" class="btn btn-primary" data-lead="quote" data-brand="GasMix" data-product="GasMix">{t(lang, 'cta.quote')} <Icon name="arrow" size={18} flip /></button>
          <button type="button" class="btn btn-wa" data-lead="whatsapp" data-brand="GasMix" data-product="GasMix"><Icon name="whatsapp" size={18} class="text-whatsapp" />{t(lang, 'cta.whatsapp')}</button>
        </div>
      </div>
      <div class="relative mx-auto grid w-full max-w-[560px] grid-cols-[1.25fr_1fr] items-end gap-4">
        <a href={L('/gasmix/aiolos-iii/')} class="relative block" aria-label="Aiolos III">
          <ProductImage brand="gasmix" brandName="GasMix" slug="aiolos-iii" alt="GasMix Aiolos III modular gas mixer and diluter" eager class="w-full drop-shadow-[0_40px_50px_rgb(0_0_0/0.5)]" />
        </a>
        <a href={L('/gasmix/zephyr-ii/')} class="relative block pb-6" aria-label="Zephyr II">
          <ProductImage brand="gasmix" brandName="GasMix" slug="zephyr-ii" alt="GasMix Zephyr II compact two-channel gas diluter" eager class="w-full drop-shadow-[0_30px_40px_rgb(0_0_0/0.5)]" />
        </a>
      </div>
    </div>
    <div class="relative border-t border-white/10">
      <ul class="wrap grid grid-cols-2 gap-px py-6 text-[14px] text-white/70 lg:grid-cols-4">
        {common.map((c) => <li class="flex items-center gap-2.5 py-2"><Icon name="check" size={16} class="shrink-0 text-brand-300" />{c}</li>)}
      </ul>
    </div>
  </section>

  <!-- Compare -->
  <section class="py-16 md:py-24" aria-labelledby="cmp-h">
    <div class="wrap">
      <p class="label text-brand-600">{ar ? 'اختر الطراز' : 'Choose a model'}</p>
      <h2 id="cmp-h" class="display mt-3 max-w-2xl text-[clamp(1.7rem,3.2vw,2.6rem)]">{ar ? 'من مخفف بقناتين إلى ست عشرة قناة.' : 'From a two-channel diluter to sixteen channels.'}</h2>
      <div class="mt-10 overflow-x-auto rounded-[var(--radius-md)] border border-line bg-card">
        <table class="w-full min-w-[760px] text-start text-[15px]">
          <thead>
            <tr class="border-b border-line text-mute">
              <th scope="col" class="label px-5 py-4 text-start font-medium">{ar ? 'الطراز' : 'Model'}</th>
              <th scope="col" class="label px-5 py-4 text-start font-medium">{ar ? 'القنوات' : 'Channels'}</th>
              <th scope="col" class="label px-5 py-4 text-start font-medium">{ar ? 'نسبة التخفيف' : 'Dilution'}</th>
              <th scope="col" class="label px-5 py-4 text-start font-medium">{ar ? 'الشكل' : 'Format'}</th>
              <th scope="col" class="label px-5 py-4 text-start font-medium">{ar ? 'التحكم' : 'Control'}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {compare.map((c) => {
              const p = bySlug.get(c.slug);
              return p && (
                <tr class="transition-colors hover:bg-brand-50/60">
                  <th scope="row" class="px-5 py-4 text-start">
                    <a href={L(productPath(brand, p))} class="tap display inline-block text-[17px] hover:text-brand-600">{p.model}</a>
                  </th>
                  <td class="px-5 py-4 font-mono text-[14px]" dir="ltr">{c.ch}</td>
                  <td class="px-5 py-4 font-mono text-[14px]" dir="ltr">{c.dil}</td>
                  <td class="px-5 py-4 text-ink-soft">{c.fmt[lang]}</td>
                  <td class="px-5 py-4 text-ink-soft">{c.ctl[lang]}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-card py-16 md:py-24" aria-labelledby="line-h">
    <div class="wrap">
      <h2 id="line-h" class="display text-[clamp(1.7rem,3.2vw,2.6rem)]">{ar ? 'مجموعة GasMix' : 'The GasMix range'}</h2>
      <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {instruments.map((p) => <ProductCard lang={lang} brand={brand} product={p} />)}
      </div>
      <h3 class="label mt-14 text-mute">{ar ? 'الملحقات' : 'Accessories'}</h3>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {accessories.map((p) => <ProductCard lang={lang} brand={brand} product={p} />)}
      </div>
    </div>
  </section>

  <ServiceStrip lang={lang} />
</Base>
