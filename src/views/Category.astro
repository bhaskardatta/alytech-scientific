---
import Base from '../layouts/Base.astro';
import { ltr } from '../lib/bidi';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { industries } from '../data/industries';
import { categoryPath, renderOf, type Category as C, type Family } from '../data/equipment';
import { breadcrumbLd, faqLd } from '../data/schema';
import { t, localize, type Lang } from '../i18n';
import { titleOf, descOf } from '../lib/seo';

interface Props { lang: Lang; family: Family; category: C }
const { lang, family, category: c } = Astro.props;
const ar = lang === 'ar';
const L = (x: string) => localize(lang, x);
const A = ar ? c.ar ?? {} : {};
const name = A.name ?? c.name;
const fam = (ar && family.ar?.name) || family.name;
const en = ar && !A.description ? 'en' : undefined;
const labels = c.typicalSpecRanges.map((s, i) => A.specLabels?.[i] ?? s.label); // values stay server-side
const faqs = A.faq ?? c.faq;
const inds = industries.filter((i) => c.industries.includes(i.slug));
const siblings = family.categories.filter((x) => x.slug !== c.slug);
const render = renderOf(c.slug);
const crumbs = [
  { label: ar ? 'الرئيسية' : 'Home', href: L('/') },
  { label: t(lang, 'nav.equipment'), href: L('/equipment/') },
  { label: name },
];
const url = L(categoryPath(c));
const title = titleOf(ar ? `${name} في الإمارات` : `${c.name} Supplier UAE`, ['AlyTech', '']);
const description = descOf(A.summary ?? c.summary, ar
  ? ['التوريد والتركيب والدعم من AlyTech في أبوظبي.', 'التوريد والدعم من AlyTech في أبوظبي.']
  : ['Supplied, installed and supported by AlyTech in Abu Dhabi.', 'Supplied and supported by AlyTech in Abu Dhabi.']);
---
<Base lang={lang} title={title} description={description} product={c.name} productLabel={name} schema={[faqLd(faqs), breadcrumbLd(crumbs, url)]}>
  <section class="border-b border-line bg-card pt-[72px]">
    <div class="wrap grid gap-10 py-10 md:py-14 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-16">
      <div class="order-1">
        <Breadcrumbs items={crumbs} />
        <p class="label mt-8 text-brand-600">{fam}</p>
        <h1 class="display mt-3 text-[clamp(2.1rem,4.6vw,3.6rem)]">{name}</h1>
        <p class="mt-5 max-w-xl text-[17px] leading-relaxed text-mute" lang={en} set:html={ltr(A.summary ?? c.summary, lang)} />
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap max-sm:*:w-full">
          <button type="button" class="btn btn-primary" data-lead="quote" data-category={c.name} data-product={c.name}>{t(lang, 'cta.quote')} <Icon name="arrow" size={18} flip /></button>
          <button type="button" class="btn btn-ghost" data-lead="specs" data-category={c.name} data-product={c.name}><Icon name="lock" size={16} />{t(lang, 'cta.specs')}</button>
          <button type="button" class="btn btn-wa" data-lead="whatsapp" data-category={c.name} data-product={c.name}><Icon name="whatsapp" size={18} class="text-whatsapp" />{t(lang, 'wa.label')}</button>
        </div>
      </div>
      <div class="order-2">
        {render ? (
          <figure class="overflow-hidden rounded-[var(--radius-lg)] ring-1 ring-line">
            <img src={render.src} width={render.w} height={render.h} alt={ar ? `صورة توضيحية: ${name}` : `${c.name}, illustrative render`} class="block h-auto w-full max-lg:max-h-[380px] max-lg:object-cover" fetchpriority="high" decoding="async" />
          </figure>
        ) : (
          <div class="render-slot relative flex aspect-[4/3] flex-col items-center justify-center gap-3 overflow-hidden rounded-[var(--radius-lg)] bg-surface p-8 text-center ring-1 ring-line">
            <Icon name="layers" size={28} class="text-brand-500" />
            <p class="label text-mute">{ar ? 'صورة ثلاثية الأبعاد قيد الإعداد' : '3D render in production'}</p>
            <p class="max-w-[28ch] text-[13px] text-mute">{name}</p>
          </div>
        )}
        <p class="mt-3 text-[12.5px] text-mute">{ar ? 'صورة توضيحية — يُحدَّد الطراز حسب مواصفاتك.' : 'Illustrative render — the model is specified to your requirement.'}</p>
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20" aria-labelledby="cat-specs-h">
    <div class="wrap grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:gap-14">
      <div>
        <p class="label text-brand-600">{ar ? 'نظرة عامة' : 'Overview'}</p>
        <h2 class="display mt-3 text-[clamp(1.6rem,3vw,2.4rem)]">{ar ? `ما يجب معرفته عن ${name}` : `${c.name}: what to know`}</h2>
        <p class="mt-6 max-w-[68ch] text-[17px] leading-[1.75] text-ink-soft" lang={en} set:html={ltr(A.description ?? c.description, lang)} />
        <div class="mt-10 grid gap-8 sm:grid-cols-2">
          {(A.variants ?? c.variants).length > 0 && (
            <div>
              <h3 class="label text-mute">{ar ? 'الأنواع والتهيئات' : 'Variants'}</h3>
              <ul class="mt-3 grid gap-2 text-[15px]" lang={ar && !A.variants ? 'en' : undefined}>{(A.variants ?? c.variants).map((v) => <li class="flex gap-3"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500"></span><span set:html={ltr(v, lang)} /></li>)}</ul>
            </div>
          )}
          <div>
            <h3 class="label text-mute">{ar ? 'التطبيقات' : 'Applications'}</h3>
            <ul class="mt-3 grid gap-2 text-[15px]" lang={ar && !A.applications ? 'en' : undefined}>{(A.applications ?? c.applications).map((v) => <li class="flex gap-3"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500"></span><span set:html={ltr(v, lang)} /></li>)}</ul>
          </div>
        </div>
        {c.standards.length > 0 && (
          <div class="mt-8">
            <h3 class="label text-mute">{ar ? 'المعايير' : 'Standards'}</h3>
            <ul class="mt-3 flex flex-wrap gap-2" dir="ltr">{c.standards.map((s) => <li class="rounded-xs border border-line-strong px-2.5 py-1 font-mono text-[13px]">{s}</li>)}</ul>
          </div>
        )}
        {inds.length > 0 && (
          <ul class="mt-8 flex flex-wrap gap-2">{inds.map((i) => <li><a href={L(`/industries/${i.slug}/`)} class="inline-flex rounded-full bg-brand-50 px-3 py-1.5 text-[13.5px] font-medium text-brand-700 transition-colors hover:bg-brand-100">{i.name[lang]}</a></li>)}</ul>
        )}
      </div>

      <aside aria-labelledby="cat-specs-h">
        <div class="card overflow-hidden lg:sticky lg:top-28">
          <div class="border-b border-line p-6">
            <p class="label flex items-center gap-2 text-brand-600"><Icon name="lock" size={14} />{ar ? 'بعد الاستفسار' : 'Shared on request'}</p>
            <h2 id="cat-specs-h" class="display mt-3 text-xl">{ar ? 'المواصفات النموذجية' : 'Typical specifications'}</h2>
          </div>
          <ul class="divide-y divide-line">
            {labels.map((l) => (
              <li class="flex items-center justify-between gap-4 px-6 py-3.5 text-[15px]">
                <span class="text-ink-soft">{l}</span>
                <span class="h-2.5 w-24 shrink-0 rounded-full bg-[repeating-linear-gradient(90deg,var(--color-line-strong)_0_6px,transparent_6px_10px)]" aria-hidden="true"></span>
              </li>
            ))}
          </ul>
          <div class="p-6">
            <button type="button" class="btn btn-primary w-full" data-lead="specs" data-category={c.name} data-product={c.name}>{t(lang, 'cta.specs')}</button>
            <p class="mt-3 text-[13px] text-mute">{ar ? 'تظهر فوراً بعد إرسال بياناتك.' : 'Shown instantly once you send your details.'}</p>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="border-t border-line bg-card py-14 md:py-20" aria-labelledby="cat-faq-h">
    <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.6fr]">
      <div>
        <h2 id="cat-faq-h" class="display text-[clamp(1.6rem,3vw,2.4rem)]">{ar ? 'أسئلة شائعة' : 'Common questions'}</h2>
        <p class="mt-4 max-w-sm text-mute">{ar ? 'نحدد المواصفات ونورّد من مصنّعين معتمدين لدينا، ونفحص ونركّب وندعم كل جهاز.' : 'We specify to your standard, source from manufacturers we have vetted, then inspect, install and support every unit.'}</p>
      </div>
      <Faq items={faqs} />
    </div>
  </section>

  {siblings.length > 0 && (
    <section class="py-14 md:py-20" aria-labelledby="sib-h">
      <div class="wrap">
        <h2 id="sib-h" class="display text-[clamp(1.4rem,2.6vw,2rem)]">{ar ? `المزيد في ${fam}` : `More in ${family.name}`}</h2>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {siblings.map((s) => (
            <li><a href={L(categoryPath(s))} class="group card flex h-full items-center gap-4 p-3 pe-5 transition-[border-color,box-shadow] duration-200 hover:border-brand-200 hover:shadow-[var(--shadow-card)]">{renderOf(s.slug) && <img src={renderOf(s.slug).sm} width="96" height="72" alt="" loading="lazy" decoding="async" class="h-[72px] w-24 shrink-0 rounded-xs object-cover" />}<span class="flex-1 font-semibold">{(ar && s.ar?.name) || s.name}</span><Icon name="arrow" size={18} flip class="shrink-0 text-mute group-hover:text-brand-600" /></a></li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>

<style>
  .render-slot {
    background-image: linear-gradient(rgb(100 90 140 / 0.07) 1px, transparent 1px), linear-gradient(90deg, rgb(100 90 140 / 0.07) 1px, transparent 1px);
    background-size: 28px 28px;
  }
</style>
