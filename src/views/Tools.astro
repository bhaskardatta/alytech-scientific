---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import { breadcrumbLd } from '../data/schema';
import { site } from '../data/site';
import { localize, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === 'ar';
const L = (x: string) => localize(lang, x);

const T = {
  en: {
    title: 'Free Engineering Calculators for Gas Work | AlyTech',
    description: 'Free calculators for gas and laboratory engineers: gas dilution flows and concentrations, and ppm to mg/m³ conversion at any temperature and pressure.',
    kicker: 'Engineering tools',
    h1: 'Free calculators for gas and laboratory work.',
    intro: 'Two working tools from AlyTech Scientific, Abu Dhabi, exclusive Middle East distributor of GasMix gas mixers and diluters. Each page shows the formula, a worked example and its assumptions, so you can check the result by hand.',
    open: 'Open the calculator',
    tools: [
      { href: '/tools/gas-dilution-calculator/', icon: 'gauge' as const, title: 'Gas dilution calculator', text: 'Find the concentration a diluter delivers from a source gas and a zero-gas stream, the flows for a target, or a multi-point calibration curve. Works in %, ppm and ppb.' },
      { href: '/tools/ppm-to-mg-m3/', icon: 'layers' as const, title: 'ppm to mg/m³ converter', text: 'Convert gas concentrations both ways at your own temperature and pressure, with molar masses preset for CO, CO₂, NO, NO₂, SO₂, H₂S, CH₄, NH₃, O₃ and benzene.' },
    ],
    stdH: 'Looking for the test method?',
    stdText: 'Our standards pages list the instruments we supply for each ASTM, ISO, EN, AASHTO and other method.',
    stdLink: 'Browse test standards',
    itemList: 'Engineering tools',
  },
  ar: {
    title: 'حاسبات هندسية مجانية لأعمال الغازات | AlyTech',
    description: 'حاسبات مجانية لمهندسي الغازات والمختبرات من AlyTech Scientific: تدفقات وتراكيز تخفيف الغازات، وتحويل ppm إلى mg/m³ عند أي درجة حرارة وضغط.',
    kicker: 'أدوات هندسية',
    h1: 'حاسبات مجانية لأعمال الغازات والمختبرات.',
    intro: 'أداتان عمليتان من AlyTech Scientific في أبوظبي، الموزع الحصري لأجهزة خلط وتخفيف الغازات GasMix في الشرق الأوسط. تعرض كل صفحة المعادلة ومثالاً محلولاً وافتراضاتها، لتتحقق من النتيجة بنفسك.',
    open: 'افتح الحاسبة',
    tools: [
      { href: '/tools/gas-dilution-calculator/', icon: 'gauge' as const, title: 'حاسبة تخفيف الغازات', text: 'احسب التركيز الذي يعطيه المخفِّف من غاز مصدر وتيار غاز صفري، أو التدفقات اللازمة لتركيز مستهدف، أو منحنى معايرة متعدد النقاط. تعمل بوحدات % وppm وppb.' },
      { href: '/tools/ppm-to-mg-m3/', icon: 'layers' as const, title: 'محوّل ppm إلى mg/m³', text: 'حوّل تراكيز الغازات في الاتجاهين عند درجة حرارتك وضغطك، مع كتل مولية جاهزة لـ CO وCO₂ وNO وNO₂ وSO₂ وH₂S وCH₄ وNH₃ وO₃ والبنزين.' },
    ],
    stdH: 'تبحث عن طريقة الاختبار؟',
    stdText: 'تسرد صفحات المعايير لدينا الأجهزة التي نورّدها لكل طريقة من ASTM وISO وEN وAASHTO وغيرها.',
    stdLink: 'تصفّح معايير الاختبار',
    itemList: 'أدوات هندسية',
  },
};
const s = T[lang];
const crumbs = [{ label: ar ? 'الرئيسية' : 'Home', href: L('/') }, { label: s.kicker }];
const url = L('/tools/');
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: s.itemList,
  itemListElement: s.tools.map((x, i) => ({ '@type': 'ListItem', position: i + 1, name: x.title, url: new URL(L(x.href), site.url).href })),
};
const webPage = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: s.h1, description: s.description, url: new URL(url, site.url).href, inLanguage: lang, isPartOf: { '@type': 'WebSite', name: site.name, url: site.url } };
---
<Base lang={lang} title={s.title} description={s.description} schema={[webPage, itemList, breadcrumbLd(crumbs, url)]}>
  <section class="border-b border-line bg-card pt-[72px]">
    <div class="wrap py-12 md:py-16">
      <Breadcrumbs items={crumbs} />
      <p class="label mt-10 text-brand-600">{s.kicker}</p>
      <h1 class="display mt-3 max-w-4xl text-[clamp(2.2rem,5vw,4rem)]">{s.h1}</h1>
      <p class="mt-5 max-w-3xl text-[18px] leading-relaxed text-ink-soft">{s.intro}</p>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <ul class="wrap grid gap-3 md:grid-cols-2">
      {s.tools.map((x) => (
        <li>
          <a href={L(x.href)} class="group card flex h-full flex-col gap-4 p-7 transition-[border-color,box-shadow] duration-200 hover:border-brand-200 hover:shadow-[var(--shadow-card)]">
            <span class="flex h-11 w-11 items-center justify-center rounded-sm bg-brand-50 text-brand-600"><Icon name={x.icon} size={22} /></span>
            <span class="display text-2xl">{x.title}</span>
            <span class="text-[15.5px] text-mute">{x.text}</span>
            <span class="link-arrow mt-auto pt-2">{s.open} <Icon name="arrow" size={16} flip /></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="border-t border-line bg-card py-12 md:py-16" aria-labelledby="tools-std-h">
    <div class="wrap flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <h2 id="tools-std-h" class="display text-[clamp(1.4rem,2.6vw,2rem)]">{s.stdH}</h2>
        <p class="mt-3 text-[16px] text-mute">{s.stdText}</p>
      </div>
      <a href={L('/standards/')} class="btn btn-ghost">{s.stdLink} <Icon name="arrow" size={18} flip /></a>
    </div>
  </section>
</Base>
