---
import Icon from './Icon.astro';
import { t, localize, type Lang } from '../i18n';
import { getSiteSettings } from '../lib/settings';

interface Props { lang: Lang }
const { lang } = Astro.props;
const cfg = await getSiteSettings();
const modes = ['whatsapp', 'datasheet', 'price', 'quote', 'specs', 'interest'] as const;
const countries = lang === 'ar'
  ? ['الإمارات العربية المتحدة', 'المملكة العربية السعودية', 'قطر', 'عُمان', 'الكويت', 'البحرين', 'العراق', 'الأردن', 'مصر', 'لبنان', 'دولة أخرى']
  : ['United Arab Emirates', 'Saudi Arabia', 'Qatar', 'Oman', 'Kuwait', 'Bahrain', 'Iraq', 'Jordan', 'Egypt', 'Lebanon', 'Other'];

// Everything the client script needs, serialised once.
const ar = lang === 'ar';
const i18n = {
  titles: Object.fromEntries(modes.map((m) => [m, t(lang, `lead.title.${m}`)])),
  subDefault: t(lang, 'lead.sub.default'),
  submitDefault: t(lang, 'lead.submit.default'),
  sending: t(lang, 'lead.sending'),
  errName: t(lang, 'lead.err.name'),
  errContact: t(lang, 'lead.err.contact'),
  // One message per failure the server can report (lead.ts picks by HTTP status); anything else gets errSend
  errTooMany: ar ? 'طلبات كثيرة من هذا الاتصال. يرجى الانتظار دقيقة ثم المحاولة مجدداً.' : 'Too many requests from this connection. Please wait a minute and try again.',
  errCheck: ar ? 'تعذّر قبول البيانات. يرجى التحقق من الاسم والبريد الإلكتروني أو رقم الجوال ثم المحاولة مجدداً.' : 'We couldn’t accept those details. Please check your name, email and mobile number, then try again.',
  errExpired: ar ? 'انتهت صلاحية هذه الصفحة. يرجى إعادة تحميلها ثم المحاولة مجدداً.' : 'This page has expired. Please reload it and try again.',
  waOpening: ar ? 'جارٍ فتح واتساب…' : 'Opening WhatsApp…',
  errSend: `${t(lang, 'lead.err.unavailable')} \u2066${cfg.contactEmail}\u2069`, // isolates keep the address intact inside Arabic text
  greeting: t(lang, 'wa.greeting'),
  general: t(lang, 'wa.general'),
  wa: cfg.whatsapp,
  waReady: cfg.whatsapp !== '971000000000', // the old placeholder: until a real number is set, WhatsApp buttons fall back to the request form
  lang,
};
---
<dialog id="lead-dialog" class="lead-dialog fixed inset-0 m-auto w-[min(560px,calc(100vw-24px))] max-h-[calc(100dvh-24px)] overflow-y-auto overscroll-contain rounded-[var(--radius-lg)] bg-card p-0 text-ink shadow-[var(--shadow-pop)]" aria-labelledby="lead-title">
  <!-- zero-height sticky row: the close button rides the top of the dialog while a tall form scrolls underneath -->
  <form method="dialog" class="sticky top-0 z-10 flex h-0 justify-end">
    <button class="me-3 mt-3 inline-flex h-11 w-11 items-center justify-center rounded-sm bg-card/90 text-mute transition-colors hover:bg-surface hover:text-ink" aria-label={t(lang, 'lead.close')}><Icon name="x" /></button>
  </form>

  <div data-lead-form-wrap class="p-6 sm:p-8">
    <p class="label flex items-center gap-2 text-brand-600" data-lead-eyebrow><Icon name="lock" size={14} /><span></span></p>
    <h2 id="lead-title" class="display mt-3 pe-10 text-2xl sm:text-[28px]" data-lead-title></h2>
    <p class="mt-2 text-[15px] text-mute" data-lead-sub></p>

    <form class="group/lead mt-6 grid gap-4" novalidate data-lead-form>
      <input type="hidden" name="mode" />
      <input type="hidden" name="product" />
      <input type="hidden" name="brand" />
      <input type="hidden" name="category" />
      <div class="sr-only" aria-hidden="true"><input name="hp_url" tabindex="-1" autocomplete="off" /></div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label for="lead-name" class="mb-1.5 block text-sm font-medium">{t(lang, 'lead.name')} <span class="text-mute">({t(lang, 'lead.required')})</span></label>
          <input id="lead-name" name="name" class="field" autocomplete="name" required aria-describedby="lead-name-err" />
          <p id="lead-name-err" class="mt-1 hidden text-sm text-danger" data-err="name"></p>
        </div>
        <div>
          <label for="lead-phone" class="mb-1.5 block text-sm font-medium">{t(lang, 'lead.phone')}</label>
          <input id="lead-phone" name="phone" type="tel" inputmode="tel" class="field" autocomplete="tel" dir="ltr" placeholder="+971" aria-describedby="lead-contact-hint lead-contact-err" />
        </div>
        <div>
          <label for="lead-email" class="mb-1.5 block text-sm font-medium">{t(lang, 'lead.email')}</label>
          <input id="lead-email" name="email" type="email" inputmode="email" class="field" autocomplete="email" dir="ltr" aria-describedby="lead-contact-hint lead-contact-err" />
        </div>
        <p id="lead-contact-hint" class="-mt-2 text-[13px] text-mute sm:col-span-2">{t(lang, 'lead.contactHint')}</p>
        <p id="lead-contact-err" class="-mt-2 hidden text-sm text-danger sm:col-span-2" data-err="contact"></p>
        <div>
          <label for="lead-company" class="mb-1.5 block text-sm font-medium">{t(lang, 'lead.company')}</label>
          <input id="lead-company" name="company" class="field" autocomplete="organization" />
        </div>
        <div>
          <label for="lead-country" class="mb-1.5 block text-sm font-medium">{t(lang, 'lead.country')}</label>
          <select id="lead-country" name="country" class="field" autocomplete="country-name">
            {countries.map((c) => <option>{c}</option>)}
          </select>
        </div>
        <div class="sm:col-span-2">
          <label for="lead-message" class="mb-1.5 block text-sm font-medium">{t(lang, 'lead.message')}</label>
          <textarea id="lead-message" name="message" rows="3" class="field resize-y"></textarea>
        </div>
      </div>
      <label class="flex items-start gap-3 text-[14px] text-ink-soft">
        <input type="checkbox" name="marketing" value="yes" class="mt-0.5 h-5 w-5 shrink-0 accent-brand-600" />
        <span>{t(lang, 'lead.marketing')}</span>
      </label>
      <p class="hidden rounded-sm bg-danger/5 px-3 py-2 text-sm text-danger outline-none" role="alert" tabindex="-1" data-lead-error></p>
      <p class="text-[12.5px] leading-relaxed text-mute">
        {t(lang, 'lead.privacy')} <a href={localize(lang, '/privacy/')} class="underline underline-offset-2 hover:text-ink">{t(lang, 'footer.privacy')}</a>.
      </p>
      <!-- last in the form so, on phones, it can stick to the bottom of the dialog without covering anything after it -->
      <div class="lead-submit-row">
        <button type="submit" class="btn btn-primary w-full" data-lead-submit>
          <span data-lead-label></span>
          <span class="hidden h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white group-aria-busy/lead:block" aria-hidden="true"></span>
          <Icon name="arrow" size={18} flip class="group-aria-busy/lead:hidden" />
        </button>
      </div>
    </form>
  </div>

  <div data-lead-done class="hidden p-8 text-center sm:p-10">
    <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-brand-50 text-brand-600"><Icon name="check" size={28} /></span>
    <!-- focus lands here on success, which is what announces it; the body is read as its description -->
    <h2 class="display mt-5 text-2xl outline-none" tabindex="-1" aria-describedby="lead-done-body" data-lead-done-title>{t(lang, 'lead.done.title')}</h2>
    <p id="lead-done-body" class="mt-2 text-mute">{t(lang, 'lead.done.body')}</p>
    <dl class="mt-6 hidden divide-y divide-line border-y border-line text-start" data-lead-specs></dl>
    <form method="dialog" class="mt-6"><button class="btn btn-ghost">{t(lang, 'lead.close')}</button></form>
  </div>
</dialog>

<script is:inline type="application/json" id="lead-i18n" set:html={JSON.stringify(i18n)} />

<!-- WhatsApp opens in a new tab with no dialog: this says so. Present from load so the live region announces the text when it's set. -->
<div class="lead-toast fixed inset-x-0 bottom-24 z-[70] mx-auto w-fit max-w-[calc(100vw-32px)] rounded-sm bg-ink px-4 py-3 text-sm font-medium text-white shadow-[var(--shadow-pop)]" role="status" aria-live="polite" aria-atomic="true" data-lead-toast></div>

<style>
  /* Opening: dialog rises and the backdrop fades in together. Closing: both fade out (allow-discrete keeps them painted; older browsers just close at once). */
  .lead-dialog { overscroll-behavior: contain; opacity: 0; transition: opacity 0.2s ease, overlay 0.2s allow-discrete, display 0.2s allow-discrete; }
  .lead-dialog[open] { opacity: 1; animation: lead-in 0.28s var(--ease-out-expo); }
  .lead-dialog:not([open]) { pointer-events: none; }
  .lead-dialog::backdrop { background: rgb(8 6 15 / 0); backdrop-filter: blur(0); transition: background-color 0.2s ease, backdrop-filter 0.2s ease; }
  .lead-dialog[open]::backdrop { background: rgb(8 6 15 / 0.6); backdrop-filter: blur(4px); animation: lead-fade 0.28s ease; }
  @keyframes lead-in { from { opacity: 0; transform: translateY(12px) scale(0.98); } }
  @keyframes lead-fade { from { background: rgb(8 6 15 / 0); backdrop-filter: blur(0); } }
  /* A focused invalid field keeps the error colour: the global purple ring would hide that it's wrong */
  .field[aria-invalid="true"]:focus { outline-color: var(--color-danger); border-color: var(--color-danger); box-shadow: 0 0 0 4px rgb(180 35 24 / 0.16); }
  /* Phones (and landscape phones): the dialog scrolls a long way, so the send button stays in reach */
  @media (max-width: 639px), (max-height: 500px) {
    .lead-dialog { scroll-padding-bottom: 88px; }
    .lead-submit-row { position: sticky; bottom: 0; z-index: 1; padding-block: 12px; background: var(--color-card); box-shadow: 0 -10px 12px -10px rgb(15 23 42 / 0.2); }
  }
  .lead-toast { opacity: 0; translate: 0 8px; pointer-events: none; transition: opacity 0.2s ease, translate 0.2s ease; }
  .lead-toast.is-on { opacity: 1; translate: 0 0; }
</style>
<style is:global>
  /* Dialog open: the page behind doesn't scroll (and the bar doesn't jump when the scrollbar goes) */
  html:has(#lead-dialog[open]) { overflow: hidden; scrollbar-gutter: stable; }
</style>

<script>
  import { openLead } from '../scripts/lead';
  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-lead]');
    if (!trigger) return;
    e.preventDefault();
    openLead({
      mode: (trigger.dataset.lead as any) || 'quote',
      product: trigger.dataset.product,
      brand: trigger.dataset.brand,
      category: trigger.dataset.category,
    });
  });
</script>
