---
import Icon from '../Icon.astro';
import { t, localize, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (p: string) => localize(lang, p);
const ar = lang === 'ar';

const copy = {
  eyebrow: ar ? 'AlyTech Scientific · أبوظبي · منذ 2015' : 'AlyTech Scientific · Abu Dhabi · since 2015',
  h1: ar ? 'أجهزة دقيقة لأكثر مختبرات الشرق الأوسط تطلباً.' : 'Precision instruments for the Middle East’s most demanding labs.',
  subShort: ar ? 'تسعة مصنّعين متخصصين، يركّبها ويدعمها مهندسونا في جميع أنحاء المنطقة.' : 'Nine specialist manufacturers, installed and supported by our own engineers across the region.',
  sub: ar
    ? 'معايرة الغازات، الخواص الحرارية، حيود الأشعة السينية، الاحتكاك والتآكل، الريولوجيا، تحليل المكامن واختبار المواد — من تسعة مصنّعين عالميين، يركّبها ويدعمها مهندسونا في جميع أنحاء المنطقة.'
    : 'Gas calibration, thermal properties, X-ray diffraction, tribology, rheology, reservoir and materials testing — from nine specialist manufacturers, installed and supported by our own engineers across the region.',
  s1k: ar ? 'GasMix™ · صُمم في فرنسا' : 'GasMix™ · designed in France',
  s1h: ar ? 'Aiolos III. مزائج معايرة عند الطلب.' : 'Aiolos III. Calibration mixtures on demand.',
  s1p: ar
    ? 'جهاز خلط وتخفيف غازات معياري من شركتنا الأم: من قناتين إلى ست قنوات، ومن مستوى النسب المئوية حتى أجزاء في البليون. يولّد المزيج الذي يحتاجه محللك عند الحاجة — بدلاً من أسطوانة لكل تركيز.'
    : 'A modular gas mixer and diluter from our parent company: two to six channels, from percent levels down to ppb. It generates the mixture your analyser needs, when it needs it — instead of a cylinder for every concentration.',
  s2k: ar ? 'نظرة إلى الداخل' : 'Look inside',
  s2h: ar ? 'كل غاز يُقاس على حدة.' : 'Every gas, metered on its own.',
  s2p: ar
    ? 'تتحكم وحدة تدفق كتلي مخصصة في كل قناة غاز، ويُمزج الناتج قبل وصوله إلى المخرج — بإدارة كاملة من برنامج AlySoft.'
    : 'A dedicated mass flow controller governs each gas channel; the streams are blended before they reach the outlet — all orchestrated by AlySoft.',
  s3k: ar ? 'شريك واحد للمختبر بأكمله' : 'One partner for the whole lab',
  s3h: ar ? 'بدأنا بـ GasMix. واليوم، تسعة مصنّعين متخصصين.' : 'GasMix is where we started. Today, nine specialist manufacturers.',
  s3p: ar
    ? 'نورّد ونركّب وندرّب ونصون كل جهاز نبيعه — بمهندسين محليين، وعقود صيانة سنوية، وقطع غيار في المنطقة.'
    : 'We supply, install, train and maintain every instrument we sell — with local engineers, annual maintenance contracts and spares held in the region.',
  hint: ar ? 'مرّر لرؤية ما بداخله' : 'Scroll to look inside',
  schematic: ar ? 'عرض تخطيطي' : 'Schematic view',
  callouts: {
    mfc: ar ? 'وحدة تحكم بالتدفق الكتلي لكل قناة' : 'Mass flow controller per channel',
    mixer: ar ? 'حجرة الخلط والمخرج' : 'Mixing chamber & outlet',
    board: ar ? 'إلكترونيات التحكم · إيثرنت إلى AlySoft' : 'Control electronics · Ethernet to AlySoft',
  },
};
---
<section id="hero" data-header="dark" class="hero on-dark relative bg-night-950 text-white" aria-label={ar ? 'مقدمة' : 'Introduction'}>
  <div class="hero-sticky sticky top-0 h-[100svh] overflow-hidden">
    <div class="hero-bg absolute inset-0" aria-hidden="true"></div>
    <img src="/images/gasmix/aiolos-iii.webp" alt="GasMix Aiolos III gas mixer and diluter" width="1299" height="1772" class="hero-fallback absolute hidden" data-hero-fallback />
    <canvas class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-700" data-hero-canvas aria-hidden="true"></canvas>

    <div class="pointer-events-none absolute inset-0" aria-hidden="true" data-callouts>
      {Object.entries(copy.callouts).map(([id, label]) => (
        <div class="callout absolute left-0 top-0 opacity-0" data-callout={id}>
          <span class="callout-dot"></span>
          <span class="callout-line"></span>
          <span class="callout-label label">{label}</span>
        </div>
      ))}
      <p class="schematic label absolute bottom-24 end-6 opacity-0 text-white/50 md:bottom-10" data-schematic>{copy.schematic}</p>
    </div>

    <div class="hero-copy wrap relative z-10 flex h-full flex-col justify-end md:justify-center">
      <div class="step step-0 max-w-[600px]" data-step="0">
        <p class="hero-eyebrow label text-brand-300">{copy.eyebrow}</p>
        <h1 class="hero-h1 display text-white">{copy.h1}</h1>
        <p class="hero-p sub-long max-w-[520px] text-white/75">{copy.sub}</p>
        <p class="hero-p sub-short max-w-[520px] text-white/75">{copy.subShort}</p>
        <div class="hero-ctas flex flex-wrap gap-3">
          <a href={L('/gasmix/')} class="btn btn-primary">{t(lang, 'cta.explore')} <Icon name="arrow" size={18} flip /></a>
          <button type="button" class="btn btn-wa" data-lead="whatsapp"><Icon name="whatsapp" size={18} class="text-whatsapp" />{t(lang, 'cta.whatsapp')}</button>
        </div>
      </div>

      {[[copy.s1k, copy.s1h, copy.s1p], [copy.s2k, copy.s2h, copy.s2p], [copy.s3k, copy.s3h, copy.s3p]].map(([k, h, p], i) => (
        <div class={`step step-n absolute max-w-[480px] opacity-0`} data-step={i + 1}>
          <p class="label text-brand-300">{k}</p>
          <h2 class="hero-h2 display text-white">{h}</h2>
          <p class="hero-p text-white/75">{p}</p>
          {i === 0 && <a href={L('/gasmix/aiolos-iii/')} class="link-arrow pointer-events-auto mt-6">{ar ? 'مواصفات Aiolos III' : 'Aiolos III specifications'} <Icon name="arrow" size={16} flip /></a>}
          {i === 2 && <a href={L('/principals/')} class="link-arrow pointer-events-auto mt-6">{ar ? 'تعرّف على شركائنا' : 'Meet our principals'} <Icon name="arrow" size={16} flip /></a>}
        </div>
      ))}
    </div>

    <div class="hero-hint absolute inset-x-0 bottom-0 z-10" aria-hidden="true">
      <div class="wrap flex items-center justify-between pb-6 text-white/55">
        <p class="label flex items-center gap-2" data-hint><Icon name="arrow-down" size={14} />{copy.hint}</p>
        <div class="hidden h-px w-32 bg-white/15 md:block"><div class="h-px origin-left bg-brand-300 rtl:origin-right" data-hero-bar></div></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { height: 420svh; }
  .hero-bg {
    background:
      radial-gradient(60% 55% at var(--glow-x, 68%) 52%, rgb(96 0 205 / 0.28), transparent 70%),
      radial-gradient(40% 40% at 20% 90%, rgb(74 34 153 / 0.25), transparent 70%),
      linear-gradient(180deg, #0b0816 0%, #08060f 100%);
  }
  :global([dir="rtl"]) .hero-bg {
    background:
      radial-gradient(60% 55% at var(--glow-x, 32%) 52%, rgb(96 0 205 / 0.28), transparent 70%),
      radial-gradient(40% 40% at 80% 90%, rgb(74 34 153 / 0.25), transparent 70%),
      linear-gradient(180deg, #0b0816 0%, #08060f 100%);
  }
  .step { will-change: opacity, transform; }

  /* Type scales with BOTH width and height so short screens (landscape phones, fold covers) never clip */
  .hero-copy { padding-block: 88px 76px; }
  .hero-h1 { margin-top: 1.1rem; font-size: clamp(1.55rem, min(5.4vw, 7.4svh), 4.4rem); }
  .hero-h2 { margin-top: 0.9rem; font-size: clamp(1.4rem, min(3.6vw, 5.6svh), 3rem); }
  .hero-p { margin-top: clamp(0.75rem, 2.4svh, 1.5rem); font-size: clamp(15px, 2.1svh, 17px); line-height: 1.6; }
  .hero-ctas { margin-top: clamp(1rem, 3.6svh, 2.25rem); }
  .sub-short { display: none; }
  @media (min-width: 1600px) { .step-0 { max-width: 680px; } }
  @media (max-width: 767px) {
    .hero-h1 { font-size: clamp(1.45rem, min(8.4vw, 4.9svh), 2.5rem); }
    .hero-h2 { font-size: clamp(1.3rem, min(7vw, 4.2svh), 2.1rem); }
  }
  /* Short or very narrow viewports: shorter subheading, no eyebrow */
  @media (max-height: 760px) and (max-width: 767px), (max-height: 560px), (max-width: 340px) {
    .sub-long { display: none; }
    .sub-short { display: block; }
  }
  @media (max-height: 520px), (max-width: 300px) { .hero-eyebrow { display: none; } .hero-h1 { margin-top: 0; } }
  @media (max-height: 520px) and (min-width: 768px) { .hero-copy { padding-block: 72px 40px; } .step-n, .step-0 { max-width: 52%; } }
  @media (max-width: 767px) { .hero-ctas :global(.btn) { min-height: 44px; padding-inline: 16px; font-size: 14px; } }
  @media (max-width: 767px) and (max-height: 700px) { .hero-eyebrow { display: none; } .hero-h1 { margin-top: 0; } }
  @media (max-height: 520px) {
    .hero-hint { display: none; }
    .hero-ctas { flex-wrap: nowrap; }
    .hero-ctas :global(.btn) { min-height: 44px; padding-inline: 14px; font-size: 14px; }
  }
  .step-n { inset-inline-start: 16px; bottom: 96px; }
  @media (min-width: 640px) { .step-n { inset-inline-start: 24px; } }
  @media (min-width: 768px) { .step-n { bottom: auto; top: 50%; translate: 0 -50%; } }
  @media (min-width: 1024px) { .step-n { inset-inline-start: 40px; } }
  @media (min-width: 1320px) { .step-n { inset-inline-start: calc((100vw - 1320px) / 2 + 40px); } }

  /* Mobile: copy sits on a scrim at the bottom, instrument above */
  @media (max-width: 767px) {
    .hero-sticky::after {
      content: ""; position: absolute; inset: auto 0 0 0; height: 62%; pointer-events: none;
      background: linear-gradient(to top, #08060f 55%, transparent);
    }
    .step, .step-n { z-index: 1; }
    .hero { height: 360svh; }
  }

  .hero-fallback { inset-inline-end: 6%; top: 14%; height: 72%; width: auto; object-fit: contain; }

  .callout { display: flex; align-items: center; gap: 0; transition: opacity 0.25s ease; }
  .callout-dot { width: 9px; height: 9px; border-radius: 99px; background: #fff; box-shadow: 0 0 0 4px rgb(185 163 255 / 0.3); flex: none; }
  .callout-line { width: 56px; height: 1px; background: rgb(255 255 255 / 0.5); flex: none; }
  .callout-label {
    color: #fff; white-space: nowrap; padding: 6px 10px; border: 1px solid rgb(255 255 255 / 0.18);
    background: rgb(16 12 29 / 0.72); backdrop-filter: blur(6px); border-radius: var(--radius-xs); font-size: 11px;
  }
  /* Parts explode toward screen-left in both languages, so labels always sit to their left */
  .callout { flex-direction: row-reverse; translate: -100% -50%; direction: ltr; }
  :global([dir="rtl"]) .callout-label { direction: rtl; }
  @media (max-width: 767px) { .callout-line { width: 22px; } .callout-label { font-size: 10px; padding: 4px 7px; } }
</style>

<script>
  const section = document.getElementById('hero')!;
  const canvas = section.querySelector<HTMLCanvasElement>('[data-hero-canvas]')!;
  const steps = [...section.querySelectorAll<HTMLElement>('[data-step]')];
  const bar = section.querySelector<HTMLElement>('[data-hero-bar]')!;
  const hint = section.querySelector<HTMLElement>('[data-hint]')!;
  const schematic = section.querySelector<HTMLElement>('[data-schematic]')!;
  const calloutEls = new Map([...section.querySelectorAll<HTMLElement>('[data-callout]')].map((el) => [el.dataset.callout!, el]));
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const rtl = document.documentElement.dir === 'rtl';
  const mq = matchMedia('(max-width: 767px)');

  // [start, end] progress window for each text step
  const windows: [number, number][] = [[-1, 0.12], [0.16, 0.38], [0.42, 0.68], [0.78, 2]];
  const fade = 0.04;
  let scene: import('../../scripts/hero/scene').HeroScene | undefined;

  const progress = () => {
    const r = section.getBoundingClientRect();
    const total = section.offsetHeight - innerHeight;
    return total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 0;
  };

  function paint() {
    const p = progress();
    steps.forEach((el, i) => {
      const [a, b] = windows[i];
      const o = Math.min(1, Math.max(0, Math.min((p - a) / fade, (b - p) / fade)));
      el.style.opacity = String(o);
      el.style.transform = `translateY(${(1 - o) * (p < a ? 24 : -24)}px)`;
      el.style.pointerEvents = o > 0.5 ? 'auto' : 'none';
      el.toggleAttribute('inert', o < 0.5);
    });
    bar.style.transform = `scaleX(${p})`;
    hint.style.opacity = String(1 - Math.min(1, p * 8));
    scene?.setProgress(p);
  }

  addEventListener('scroll', paint, { passive: true });
  addEventListener('resize', paint);
  paint();

  function layout() {
    const short = innerHeight / innerWidth < 1.95; // e.g. iPhone SE: push the instrument higher and smaller
    // Desktop: anchor the instrument to the 1320px content column, not the screen edge (ultrawide-safe)
    const desk = Math.min(0.2, (Math.min(innerWidth, 1320) * 0.22) / innerWidth) * (rtl ? -1 : 1);
    const offsetX = mq.matches ? 0.14 : desk;
    section.style.setProperty('--glow-x', `${50 + offsetX * 100}%`);
    scene?.setLayout({ offsetX, offsetY: mq.matches ? (short ? 0.27 : 0.25) : 0, mobile: mq.matches, compact: mq.matches && short });
  }

  async function boot() {
    const gl = document.createElement('canvas').getContext('webgl2');
    if (!gl) { section.querySelector('[data-hero-fallback]')!.classList.remove('hidden'); return; }
    const { createHeroScene } = await import('../../scripts/hero/scene');
    await document.fonts?.ready; // canvas textures use the web fonts
    scene = createHeroScene(canvas, { mobile: mq.matches, reducedMotion: reduced });
    layout();
    mq.addEventListener('change', layout);
    addEventListener('resize', layout);
    new ResizeObserver(() => scene!.resize()).observe(canvas);

    scene.onFrame(() => {
      const e = scene!.explodeAmount();
      schematic.style.opacity = String(Math.min(1, e * 1.5) * 0.9);
      for (const c of scene!.callouts) {
        const el = calloutEls.get(c.id)!;
        const s = scene!.project(c.anchor);
        el.style.left = `${s.x}px`;
        el.style.top = `${s.y}px`;
        el.style.opacity = String(Math.max(0, e * 1.6 - 0.6));
      }
    });

    paint();
    canvas.classList.remove('opacity-0');
    // Only render while the hero is on screen
    new IntersectionObserver(([en]) => (en.isIntersecting ? scene!.start() : scene!.stop())).observe(section);
    if (reduced) scene.setProgress(progress());
  }

  // Let the copy paint first; WebGL loads once the page is idle.
  const idle = (window as any).requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 200));
  if (document.readyState === 'complete') idle(boot); else addEventListener('load', () => idle(boot), { once: true });
</script>
