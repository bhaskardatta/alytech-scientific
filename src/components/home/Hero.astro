---
import Icon from '../Icon.astro';
import { t, localize, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (p: string) => localize(lang, p);
const ar = lang === 'ar';

const copy = {
  eyebrow: ar ? 'AlyTech Scientific · أبوظبي · منذ 2015' : 'AlyTech Scientific · Abu Dhabi · since 2015',
  h1: ar ? 'أجهزة دقيقة لأكثر مختبرات الشرق الأوسط تطلباً.' : 'Precision instruments for the Middle East’s most demanding labs.',
  subShort: ar ? 'نمثّل المصنّعين وندعم العملاء في جميع أنحاء الشرق الأوسط.' : 'We represent manufacturers and support customers across the Middle East.',
  sub: ar
    ? 'معايرة الغازات، الخواص الحرارية، حيود الأشعة السينية، الاحتكاك والتآكل، الريولوجيا، تحليل المكامن واختبار المواد — نمثّل المصنّعين وندعم العملاء في جميع أنحاء الشرق الأوسط، بمهندسينا في الموقع.'
    : 'Gas calibration, thermal properties, X-ray diffraction, tribology, rheology, reservoir and materials testing. We represent the manufacturers and support customers across the Middle East, with our own engineers on site.',
  s1k: ar ? 'GasMix™ · صُمم في فرنسا' : 'GasMix™ · designed in France',
  s1h: ar ? 'Aiolos III. مزائج معايرة عند الطلب.' : 'Aiolos III. Calibration mixtures on demand.',
  s1p: ar
    ? 'جهاز خلط وتخفيف غازات معياري: من قناتين إلى ست قنوات، ومن مستوى النسب المئوية حتى أجزاء في البليون. يولّد المزيج الذي يحتاجه محللك عند الحاجة — بدلاً من أسطوانة لكل تركيز.'
    : 'A modular gas mixer and diluter: two to six channels, from percent levels down to ppb. It generates the mixture your analyser needs, when it needs it — instead of a cylinder for every concentration.',
  s2k: ar ? 'نظرة إلى الداخل' : 'Look inside',
  s2h: ar ? 'كل غاز يُقاس على حدة.' : 'Every gas, metered on its own.',
  s2p: ar
    ? 'تتحكم وحدة تدفق كتلي مخصصة في كل قناة غاز، ويُمزج الناتج قبل وصوله إلى المخرج — بإدارة كاملة من برنامج AlySoft.'
    : 'A dedicated mass flow controller governs each gas channel; the streams are blended before they reach the outlet — all orchestrated by AlySoft.',
  s3k: ar ? 'شريك واحد للمختبر بأكمله' : 'One partner for the whole lab',
  s3h: ar ? 'بدأنا بـ GasMix. واليوم نمثّل مصنّعين لكل أقسام المختبر.' : 'GasMix is where we started. Today, we represent manufacturers across the lab.',
  s3p: ar
    ? 'نورّد ونركّب وندرّب ونصون كل جهاز نبيعه — بمهندسين محليين، وعقود صيانة سنوية، وقطع غيار في المنطقة.'
    : 'We supply, install, train and maintain every instrument we sell — with local engineers, annual maintenance contracts and spares held in the region.',
  hint: ar ? 'مرّر لرؤية ما بداخله' : 'Scroll to look inside',
  schematic: ar ? 'عرض تخطيطي' : 'Schematic view',
  // [full label, short label for phones]
  callouts: {
    mfc: ar ? ['وحدة تحكم بالتدفق الكتلي لكل قناة', 'وحدة MFC لكل قناة'] : ['Mass flow controller per channel', 'MFC per channel'],
    mixer: ar ? ['حجرة الخلط والمخرج', 'حجرة الخلط'] : ['Mixing chamber & outlet', 'Mixing chamber'],
    board: ar ? ['إلكترونيات التحكم · إيثرنت إلى AlySoft', 'إلكترونيات التحكم'] : ['Control electronics · Ethernet to AlySoft', 'Control electronics'],
  },
};
---
<section id="hero" data-header="dark" class="hero on-dark relative bg-night-950 text-white" aria-label={ar ? 'مقدمة' : 'Introduction'}>
  <div class="hero-sticky sticky top-0 h-[100svh] overflow-hidden">
    <div class="hero-bg absolute inset-0" aria-hidden="true"></div>
    <img src="/images/gasmix/aiolos-iii.webp" srcset="/images/gasmix/aiolos-iii-sm.webp 480w, /images/gasmix/aiolos-iii.webp 1299w" sizes="(max-width: 767px) 40vw, 380px" alt={ar ? 'جهاز GasMix Aiolos III لخلط الغازات وتخفيفها' : 'GasMix Aiolos III gas mixer and diluter'} width="1299" height="1772" loading="lazy" decoding="async" class="hero-fallback absolute hidden" data-hero-fallback />
    <canvas class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-700" data-hero-canvas aria-hidden="true"></canvas>
    <p class="hero-debug hidden" data-hero-debug></p>

    {/* overflow-clip: the labels start off-screen; in RTL that leaked scrollable overflow into .hero-sticky, and its removal on boot registered as a 0.23 layout shift */}
    <div class="pointer-events-none absolute inset-0 overflow-clip" aria-hidden="true" data-callouts>
      {Object.entries(copy.callouts).map(([id, label]) => (
        <div class="callout absolute left-0 top-0 opacity-0" data-callout={id}>
          <span class="callout-dot"></span>
          <span class="callout-line"></span>
          <span class="callout-label label"><span class="callout-long">{label[0]}</span><span class="callout-short">{label[1]}</span></span>
        </div>
      ))}
      <p class="schematic label absolute bottom-24 end-6 opacity-0 text-white/50 md:bottom-10" data-schematic>{copy.schematic}</p>
    </div>

    <div class="hero-copy wrap relative z-10 flex h-full flex-col justify-end md:justify-center">
      <div class="step step-0 max-w-[600px]" data-step="0">
        <p class="hero-eyebrow label text-brand-300">{copy.eyebrow}</p>
        <h1 class="hero-h1 display text-white">{copy.h1}</h1>
        <p class="hero-p sub-long max-w-[520px] text-white/75">{copy.sub}</p>
        <p class="hero-p sub-short max-w-[520px] text-white/75">{copy.subShort}</p>
        <div class="hero-ctas flex flex-wrap gap-3">
          <a href={L('/gasmix/')} class="btn btn-primary">{t(lang, 'cta.explore')} <Icon name="arrow" size={18} flip /></a>
          <button type="button" class="btn btn-wa" data-lead="whatsapp"><Icon name="whatsapp" size={18} class="text-whatsapp" />{t(lang, 'cta.whatsapp')}</button>
        </div>
      </div>

      {[[copy.s1k, copy.s1h, copy.s1p], [copy.s2k, copy.s2h, copy.s2p], [copy.s3k, copy.s3h, copy.s3p]].map(([k, h, p], i) => (
        <div class={`step step-n absolute max-w-[480px] opacity-0`} data-step={i + 1}>
          <p class="label text-brand-300">{k}</p>
          <h2 class="hero-h2 display text-white">{h}</h2>
          <p class="hero-p text-white/75">{p}</p>
          {i === 0 && <a href={L('/gasmix/aiolos-iii/')} class="link-arrow pointer-events-auto mt-6">{ar ? 'مواصفات Aiolos III' : 'Aiolos III specifications'} <Icon name="arrow" size={16} flip /></a>}
          {i === 2 && <a href={L('/principals/')} class="link-arrow pointer-events-auto mt-6">{ar ? 'تعرّف على شركائنا' : 'Meet our principals'} <Icon name="arrow" size={16} flip /></a>}
        </div>
      ))}
    </div>

    <div class="hero-hint absolute inset-x-0 bottom-0 z-10" aria-hidden="true">
      <div class="wrap flex items-center justify-between pb-6 text-white/55">
        <p class="label flex items-center gap-2" data-hint><Icon name="arrow-down" size={14} />{copy.hint}</p>
        <div class="hidden h-px w-32 bg-white/15 md:block"><div class="h-px origin-left bg-brand-300 rtl:origin-right" data-hero-bar></div></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { height: 420svh; }
  .hero-bg {
    background:
      radial-gradient(60% 55% at var(--glow-x, 68%) 52%, rgb(96 0 205 / 0.28), transparent 70%),
      radial-gradient(40% 40% at 20% 90%, rgb(74 34 153 / 0.25), transparent 70%),
      linear-gradient(180deg, #0b0816 0%, #08060f 100%);
  }
  :global([dir="rtl"]) .hero-bg {
    background:
      radial-gradient(60% 55% at var(--glow-x, 32%) 52%, rgb(96 0 205 / 0.28), transparent 70%),
      radial-gradient(40% 40% at 80% 90%, rgb(74 34 153 / 0.25), transparent 70%),
      linear-gradient(180deg, #0b0816 0%, #08060f 100%);
  }
  .step { will-change: opacity, transform; }

  /* Type scales with BOTH width and height so short screens (landscape phones, fold covers) never clip */
  .hero-copy { padding-block: 88px 76px; }
  .hero-h1 { margin-top: 1.1rem; font-size: clamp(1.55rem, min(5.4vw, 7.4svh), 4.4rem); }
  .hero-h2 { margin-top: 0.9rem; font-size: clamp(1.4rem, min(3.6vw, 5.6svh), 3rem); }
  .hero-p { margin-top: clamp(0.75rem, 2.4svh, 1.5rem); font-size: clamp(15px, 2.1svh, 17px); line-height: 1.6; }
  .hero-ctas { margin-top: clamp(1rem, 3.6svh, 2.25rem); }
  .sub-short { display: none; }
  @media (min-width: 1600px) { .step-0 { max-width: 680px; } }
  @media (max-width: 767px) {
    .hero-h1 { font-size: clamp(1.45rem, min(8.4vw, 4.9svh), 2.5rem); }
    .hero-h2 { font-size: clamp(1.3rem, min(7vw, 4.2svh), 2.1rem); }
  }
  /* Phones and short viewports: shorter subheading, so the instrument keeps room above the copy */
  @media (max-width: 767px), (max-height: 560px) {
    .sub-long { display: none; }
    .sub-short { display: block; }
  }
  /* Very short phones (iPhone SE class): headline and buttons only, so the instrument still fits above them */
  @media (max-width: 767px) and (max-height: 600px) { .sub-short { display: none; } }
  @media (max-height: 520px), (max-width: 300px) { .hero-eyebrow { display: none; } .hero-h1 { margin-top: 0; } }
  @media (max-height: 520px) and (min-width: 768px) { .hero-copy { padding-block: 72px 40px; } .step-n, .step-0 { max-width: 52%; } }
  @media (max-width: 767px) { .hero-ctas :global(.btn) { min-height: 44px; padding-inline: 16px; font-size: 14px; } }
  @media (max-width: 767px) and (max-height: 700px) { .hero-eyebrow { display: none; } .hero-h1 { margin-top: 0; } }
  @media (max-height: 520px) {
    .hero-hint { display: none; }
    .hero-ctas { flex-wrap: nowrap; }
    .hero-ctas :global(.btn) { min-height: 44px; padding-inline: 14px; font-size: 14px; }
  }
  .step-n { inset-inline-start: 16px; bottom: 96px; }
  @media (min-width: 640px) { .step-n { inset-inline-start: 24px; } }
  @media (min-width: 768px) { .step-n { bottom: auto; top: 50%; translate: 0 -50%; } }
  @media (min-width: 1024px) { .step-n { inset-inline-start: 40px; } }
  @media (min-width: 1320px) { .step-n { inset-inline-start: calc((100vw - 1320px) / 2 + 40px); } }

  /* Phones and portrait tablets: copy sits on a scrim at the bottom, instrument above (side by side doesn't fit under 1024px) */
  @media (max-width: 767px), (max-width: 1023px) and (min-height: 600px) {
    .hero-copy { justify-content: flex-end; }
    .step-n { top: auto; bottom: 96px; translate: none; }
    .hero-sticky::after {
      content: ""; position: absolute; inset: auto 0 0 0; height: 62%; pointer-events: none;
      background: linear-gradient(to top, #08060f 55%, transparent);
    }
    .step, .step-n { z-index: 1; }
    .hero { height: 360svh; }
  }

  .hero-fallback { inset-inline-end: 6%; top: 14%; height: 72%; width: auto; object-fit: contain; }
  /* Phones: a fixed 200px box under the header; the script only scales it into the free band above the copy (--model-s).
     Transform, not top/height, so adjusting it after fonts load can never register as layout shift. */
  @media (max-width: 767px), (max-width: 1023px) and (min-height: 600px) {
    .hero-fallback { top: 80px; height: 200px; inset-inline-end: 8%; transform-origin: 50% 0; transform: scale(var(--model-s, 1)); }
  }

  .callout { display: flex; align-items: center; gap: 0; transition: opacity 0.25s ease; }
  .callout-dot { width: 9px; height: 9px; border-radius: 99px; background: #fff; box-shadow: 0 0 0 4px rgb(185 163 255 / 0.3); flex: none; }
  .callout-line { width: 56px; height: 1px; background: rgb(255 255 255 / 0.5); flex: none; }
  .callout-label {
    color: #fff; white-space: nowrap; padding: 6px 10px; border: 1px solid rgb(255 255 255 / 0.18);
    background: rgb(16 12 29 / 0.72); backdrop-filter: blur(6px); border-radius: var(--radius-xs); font-size: 11px;
  }
  /* Parts explode toward screen-left in both languages, so labels always sit to their left */
  .callout { flex-direction: row-reverse; translate: -100% -50%; direction: ltr; }
  :global([dir="rtl"]) .callout-label { direction: rtl; }
  .hero-debug {
    position: absolute; inset-inline: 12px; top: 84px; z-index: 30; margin: 0; padding: 8px 10px;
    font: 500 12px/1.4 var(--font-mono, monospace); color: #fff; background: rgb(16 12 29 / 0.88);
    border: 1px solid rgb(255 255 255 / 0.25); border-radius: var(--radius-xs); overflow-wrap: anywhere;
  }
  .callout-short { display: none; }
  .callout.flip { flex-direction: row; translate: 0 -50%; }
  @media (max-width: 767px) {
    .callout-line { width: 22px; }
    .callout-label { font-size: 10px; padding: 4px 7px; }
    .callout-long { display: none; }
    .callout-short { display: inline; }
  }
</style>

<script>
  const section = document.getElementById('hero')!;
  const canvas = section.querySelector<HTMLCanvasElement>('[data-hero-canvas]')!;
  const fallbackImg = section.querySelector<HTMLElement>('[data-hero-fallback]')!;
  const steps = [...section.querySelectorAll<HTMLElement>('[data-step]')];
  const bar = section.querySelector<HTMLElement>('[data-hero-bar]')!;
  const hint = section.querySelector<HTMLElement>('[data-hint]')!;
  const schematic = section.querySelector<HTMLElement>('[data-schematic]')!;
  const calloutEls = new Map([...section.querySelectorAll<HTMLElement>('[data-callout]')].map((el) => [el.dataset.callout!, el]));
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const rtl = document.documentElement.dir === 'rtl';
  const mq = matchMedia('(max-width: 767px), (max-width: 1023px) and (min-height: 600px)'); // stacked layout: instrument in the band above the copy
  // Lighter render (fewer segments, 1.5x pixel ratio) on every touch device: tablets have less GPU memory than desktops,
  // and a lost WebGL context would drop them to the still image. Desktop quality is unchanged.
  const lite = matchMedia('(max-width: 767px), (pointer: coarse)').matches;

  // [start, end] progress window for each text step
  const windows: [number, number][] = [[-1, 0.12], [0.16, 0.38], [0.42, 0.68], [0.78, 2]];
  const fade = 0.04;
  let scene: import('../../scripts/hero/scene').HeroScene | undefined;
  let io: IntersectionObserver | undefined;

  const progress = () => {
    const r = section.getBoundingClientRect();
    const total = section.offsetHeight - innerHeight;
    return total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 0;
  };

  function paint() {
    const p = progress();
    steps.forEach((el, i) => {
      const [a, b] = windows[i];
      const o = Math.min(1, Math.max(0, Math.min((p - a) / fade, (b - p) / fade)));
      el.style.opacity = String(o);
      el.style.transform = reduced ? '' : `translateY(${(1 - o) * (p < a ? 24 : -24)}px)`;
      el.style.pointerEvents = o > 0.5 ? 'auto' : 'none';
      el.toggleAttribute('inert', o < 0.5);
    });
    bar.style.transform = `scaleX(${p})`;
    hint.style.opacity = String(1 - Math.min(1, p * 8));
    scene?.setProgress(p);
  }

  addEventListener('scroll', paint, { passive: true });
  addEventListener('resize', paint);
  paint();

  // Phones: the instrument (3D or poster) lives in the band between the header and the tallest copy block,
  // so text and model can't collide whatever the viewport height, language or font.
  function band() {
    const H = canvas.clientHeight || innerHeight;
    const top = 80;
    const copyTop = Math.min(...steps.map((el) => el.offsetTop));
    const h = Math.max(120, copyTop - 12 - top);
    return { H, top, h, cy: top + h / 2 };
  }

  function layout() {
    let offsetY = 0;
    let fit: number | undefined;
    if (mq.matches) {
      const { H, h, cy } = band();
      section.style.setProperty('--model-s', String(h / 200));
      offsetY = (H / 2 - cy) / H;
      // camera distance multiplier so the model's height at its closest keyframe fills the band (0.66 ≈ model height / visible height at 1x)
      fit = Math.min(3.2, Math.max(1, 0.66 / (h / H)));
    } else {
      section.style.removeProperty('--model-s');
    }
    // Desktop: anchor the instrument to the 1320px content column, not the screen edge (ultrawide-safe)
    const desk = Math.min(0.2, (Math.min(innerWidth, 1320) * 0.22) / innerWidth) * (rtl ? -1 : 1);
    const offsetX = mq.matches ? 0.14 : desk;
    section.style.setProperty('--glow-x', `${50 + offsetX * 100}%`);
    scene?.setLayout({ offsetX, offsetY, mobile: mq.matches, fit });
  }
  // Copy height changes with fonts, language and viewport; the observer also fires once on observe, which sets the first layout.
  let queued = 0;
  const relayout = new ResizeObserver(() => { cancelAnimationFrame(queued); queued = requestAnimationFrame(layout); });
  steps.forEach((el) => relayout.observe(el));
  mq.addEventListener('change', layout);
  addEventListener('resize', layout);

  // Small screens: keep every label on screen and off the others. A label that would leave the screen moves to the other
  // side of its dot; overlapping labels are pushed down. CSSOM only (no style attributes), so the CSP is unaffected.
  function fitCallouts() {
    const items = [...calloutEls.values()].map((el) => {
      const label = el.querySelector<HTMLElement>('.callout-label')!;
      el.classList.remove('flip');
      label.style.translate = '';
      if (label.getBoundingClientRect().left < 8) el.classList.add('flip');
      return { label, r: label.getBoundingClientRect() };
    }).sort((a, b) => a.r.top - b.r.top);
    let floor = -Infinity;
    for (const { label, r } of items) {
      const overlaps = r.top < floor;
      const dy = overlaps ? floor - r.top : 0;
      if (dy) label.style.translate = `0 ${dy}px`;
      floor = r.bottom + dy + 4;
    }
  }

  // Static image: no WebGL, reduced motion, or a runtime failure. The <img> is lazy, so it only downloads once shown.
  // ---------- 3D health report ----------
  // Every device reports once whether the 3D started and, if not, why (anonymous: status, reason and render flags only).
  // Add ?debug3d to the URL to see the same report on screen.
  const debugEl = section.querySelector<HTMLElement>('[data-hero-debug]')!;
  const debug = /[?&]debug3d\b/.test(location.search);
  const sent = new Set<string>();
  const notes: string[] = [];
  function report(status: string, what = '', e?: unknown) {
    const reason = e instanceof Error ? `${e.name}: ${e.message}` : e ? String(e) : '';
    document.documentElement.dataset.hero = status;
    if (debug) {
      notes.push(`${status}${what ? ` · ${what}` : ''}${reason ? ` — ${reason}` : ''}`);
      debugEl.textContent = `3D: ${notes.join(' | ')} · lite=${lite} reducedMotion=${reduced} dpr=${devicePixelRatio} ${innerWidth}×${innerHeight}`;
      debugEl.classList.remove('hidden');
    }
    const key = status + what;
    if (sent.has(key)) return;
    sent.add(key);
    const body = JSON.stringify({ type: 'hero', path: location.pathname, status, what, reason: reason.slice(0, 300), lite, reduced, dpr: devicePixelRatio, vw: innerWidth, vh: innerHeight, ts: Date.now() });
    try { navigator.sendBeacon?.('/api/track/', new Blob([body], { type: 'application/json' })); } catch {}
  }

  function showFallback(e?: unknown) {
    report('fallback', 'fatal', e);
    io?.disconnect();
    scene?.dispose();
    scene = undefined;
    canvas.classList.add('hidden');
    fallbackImg.classList.remove('hidden');
    schematic.style.opacity = '0';
    calloutEls.forEach((el) => (el.style.opacity = '0'));
  }

  async function boot() {
    const probe = document.createElement('canvas').getContext('webgl2');
    if (!probe) return showFallback('no WebGL2');
    probe.getExtension('WEBGL_lose_context')?.loseContext();
    try {
      // One retry: a dropped connection (or a bot check on a busy network) must not cost the visitor the 3D.
      const load = () => import('../../scripts/hero/scene');
      const { createHeroScene } = await load().catch(() => new Promise((r) => setTimeout(r, 1500)).then(load));
      // Canvas textures draw text, so the faces must be loaded first (hashed, lazy unicode-range files) — but never wait long.
      const css = getComputedStyle(document.documentElement);
      const fonts = { display: css.getPropertyValue('--font-archivo').trim() || 'sans-serif', mono: css.getPropertyValue('--font-jetbrains').trim() || 'monospace' };
      // A font that fails to download (flaky mobile network, blocked file) only means the labels use a system face.
      // It must never cost the visitor the 3D, so a rejected load is reported and ignored.
      const faces = (f: string) => {
        try { return document.fonts.load(f).catch((e) => report('issue', 'font', e)); } catch (e) { report('issue', 'font', e); return Promise.resolve(); }
      };
      // Wait for our own font files only: the stacks also name metric fallbacks such as local("Arial") and local("Courier New"),
      // which Android doesn't have, and asking the browser to load those rejects with a NetworkError.
      const own = (stack: string) => stack.split(',')[0].trim();
      await Promise.race([
        Promise.all([faces(`600 64px ${own(fonts.display)}`), faces(`500 20px ${own(fonts.mono)}`)]),
        new Promise((r) => setTimeout(r, 2500)),
      ]);
      scene = await createHeroScene(canvas, { mobile: lite, reducedMotion: reduced, fonts, onFail: showFallback, onIssue: (what, e) => report('issue', what, e) });
      layout();
      new ResizeObserver(() => scene?.resize()).observe(canvas);

      scene.onFrame(() => {
        if (!scene) return;
        const e = scene.explodeAmount();
        schematic.style.opacity = String(Math.min(1, e * 1.5) * 0.9);
        for (const c of scene.callouts) {
          const el = calloutEls.get(c.id)!;
          const s = scene.project(c.anchor);
          el.style.transform = `translate(${s.x}px, ${s.y}px)`; // transform, not left/top: moving them must not count as layout shift
          el.style.opacity = String(Math.max(0, e * 1.6 - 0.6));
        }
        if (e > 0.3 && innerWidth < 1024) fitCallouts();
      });

      paint();
      canvas.classList.remove('opacity-0');
      report('ok');
      // Only render while the hero is on screen
      io = new IntersectionObserver(([en]) => (en.isIntersecting ? scene?.start() : scene?.stop()));
      io.observe(section);
    } catch (e) {
      showFallback(e);
    }
  }

  // Let the copy paint first, then boot WebGL when idle. Reduced-motion visitors get the 3D too, but nothing moves on its own:
  // no idle float or drift (scene reducedMotion) and no text slide (paint) — the model only changes as they scroll.
  const idle = (window as any).requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 200));
  if (document.readyState === 'complete') idle(boot); else addEventListener('load', () => idle(boot), { once: true });
</script>
