---
/** Closing call to action for the end of a page: one primary action (quote) and WhatsApp beside it. */
import Icon from './Icon.astro';
import Ribbon from './Ribbon.astro';
import { t, type Lang } from '../i18n';

interface Props { lang: Lang; title: string; text: string; product?: string }
const { lang, title, text, product } = Astro.props;
---
<section data-header="dark" class="on-dark relative overflow-hidden bg-night-900 py-16 text-white md:py-24" aria-labelledby="cta-band-h">
  <Ribbon class="absolute inset-0 h-full w-full text-brand-500 opacity-40" lines={36} />
  <div class="wrap relative grid gap-8 lg:grid-cols-[1.5fr_1fr] lg:items-end">
    <div>
      <h2 id="cta-band-h" class="display max-w-2xl text-[clamp(1.9rem,3.6vw,3rem)] text-balance">{title}</h2>
      <p class="mt-4 max-w-xl text-[17px] leading-relaxed text-white/75">{text}</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap lg:justify-end max-sm:*:w-full">
      <button type="button" class="btn btn-primary" data-lead="quote" data-product={product}>{t(lang, 'cta.quote')} <Icon name="arrow" size={18} flip /></button>
      <button type="button" class="btn btn-wa" data-lead="whatsapp" data-product={product}><Icon name="whatsapp" size={18} class="text-whatsapp" />{t(lang, 'cta.whatsapp')}</button>
    </div>
  </div>
</section>
