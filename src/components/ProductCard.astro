---
import { ltr } from '../lib/bidi';
import ProductImage from './ProductImage.astro';
import Icon from './Icon.astro';
import { productPath, shortName, imageOf, type Product } from '../data/catalog';
import { localize, pick, type Lang } from '../i18n';
import type { Brand } from '../data/brands';

interface Props { lang: Lang; brand: Brand; product: Product; tone?: 'light' | 'dark' }
const { lang, brand, product: p, tone = 'light' } = Astro.props;
const dark = tone === 'dark';
// Photos shot on a white background sit on a light stage (blended into it), even inside a dark card; dark studio
// shots sit on their own backdrop colour (#242424, set by tools/sync-catalog.py padding).
const photo = imageOf(brand.slug, p.slug);
const lightStage = !dark || !!photo?.opaque;
const href = localize(lang, productPath(brand, p));
---
<a href={href} class:list={['group flex h-full flex-col overflow-hidden rounded-[var(--radius-md)] border transition-[border-color,box-shadow,transform] duration-200 hover:-translate-y-0.5', dark ? 'border-white/10 bg-night-800/60 text-white hover:border-brand-300/40' : 'card hover:border-brand-200 hover:shadow-[var(--shadow-card)]']}>
  {/* Fixed 4:3 stage; the image is contained inside it, so every card in a row has the same image area whatever the photo's shape */}
  <div class:list={['stage relative aspect-[4/3] overflow-hidden', photo?.dark ? 'bg-[#242424]' : lightStage ? 'bg-surface' : 'bg-white/[0.04]']}>
    <ProductImage brand={brand.slug} brandName={brand.name} slug={p.slug} decorative alt="" class="absolute inset-0 h-full w-full p-6 transition-transform duration-500 group-hover:scale-[1.03]" sizes="(min-width: 1024px) 25vw, 50vw" />
  </div>
  <div class="flex flex-1 flex-col gap-2 p-5">
    <p class:list={['label', dark ? 'text-brand-300' : 'text-mute']}>{pick(lang, { en: p.category, ar: p.ar?.category })}</p>
    <p class="display text-lg" set:html={ltr(shortName(p, lang), lang)} />
    <p class:list={['line-clamp-3 text-[14.5px]', dark ? 'text-white/65' : 'text-mute']} lang={lang === 'ar' && !p.ar?.summary ? 'en' : undefined} set:html={ltr(pick(lang, { en: p.summary, ar: p.ar?.summary }) ?? '', lang)} />
    <span class:list={['link-arrow mt-auto pt-3 text-sm']}>{lang === 'ar' ? 'التفاصيل' : 'Details'} <Icon name="arrow" size={16} flip /></span>
  </div>
</a>
