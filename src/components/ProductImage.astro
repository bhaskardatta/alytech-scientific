---
import { brandInfo, imageOf } from '../data/catalog';
import { t, type Lang } from '../i18n';
/** `decorative`: the product name is already visible next to the image (cards), so the image is skipped by screen readers. */
interface Props { brand: string; brandName: string; slug: string; alt: string; class?: string; eager?: boolean; sizes?: string; decorative?: boolean }
const { brand, brandName, slug, alt, class: cls = '', eager = false, sizes = '(min-width: 1024px) 40vw, 90vw', decorative = false } = Astro.props;
const img = imageOf(brand, slug);
// Callers don't pass a locale, so read it from the URL (English at the root, Arabic under /ar/).
const lang: Lang = /^\/ar(\/|$)/.test(Astro.url.pathname) ? 'ar' : 'en';
const arName = lang === 'ar' ? brandInfo(brand)?.products.find((p) => p.slug === slug)?.ar?.name : undefined;
const label = decorative ? '' : arName ? `${brandName} ${arName}` : alt;
---
{img ? (
  <img
    src={img.src}
    width={img.w}
    height={img.h}
    alt={label}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
    class:list={['object-contain', cls, img.opaque && 'img-opaque']}
  />
) : (
  <div class:list={['placeholder flex items-center justify-center text-center', cls]} role={decorative ? undefined : 'img'} aria-label={label || undefined} aria-hidden={decorative ? 'true' : undefined}>
    <span class="label max-w-[16ch] text-mute [overflow-wrap:anywhere]">{t(lang, 'img.onRequest')}</span>
  </div>
)}
<style>
  .placeholder {
    aspect-ratio: 4 / 3;
    width: 100%;
    background: repeating-linear-gradient(45deg, #eceaf2, #eceaf2 10px, #f5f4f9 10px, #f5f4f9 20px);
    border-radius: var(--radius-sm);
  }
</style>
