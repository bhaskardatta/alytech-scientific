---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadModal from '../components/LeadModal.astro';
import Consent from '../components/Consent.astro';
import Nudge from '../components/Nudge.astro';
import Icon from '../components/Icon.astro';
import Announcement from '../components/Announcement.astro';
import { site } from '../data/site';
import { t, dir, localize, unlocalize, type Lang } from '../i18n';
import { fit, TITLE_MAX, DESC_MAX } from '../lib/seo';
import { getSiteSettings, announcementLive } from '../lib/settings';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** JSON-LD objects for this page (Organization is added automatically). */
  schema?: object[];
  image?: string;
  /** Marks product pages for engagement tracking + nudges. */
  product?: string;
  /** Localized display name for the nudge; `product` stays English for lead records. */
  productLabel?: string;
  noindex?: boolean;
  /** false for pages with no twin to point at (404): no canonical, hreflang or og:url. */
  alternates?: boolean;
}
const { lang, title: rawTitle, description: rawDesc, schema = [], image, product, productLabel, noindex, alternates = true } = Astro.props;
// Last line of defence: views build their own meta (src/lib/seo.ts); anything over budget is trimmed on a word boundary and flagged.
const title = rawTitle.length > TITLE_MAX ? fit(rawTitle, TITLE_MAX).replace(/\.$/, '') : rawTitle;
const description = rawDesc.length > DESC_MAX ? fit(rawDesc, DESC_MAX - 5) : rawDesc;
if (title !== rawTitle || description !== rawDesc) console.warn(`[seo] meta over budget on ${Astro.url.pathname}: shorten it in the view`);
// Owner-editable values (src/lib/settings.ts), read while the site builds; falls back to src/data/site.ts if the database is unreachable.
const cfg = await getSiteSettings();
const bar = announcementLive(cfg.announcement);
const path = Astro.url.pathname;
const base = unlocalize(path);
const canonical = new URL(path, site.url).href;
const alt = (l: Lang) => new URL(localize(l, base), site.url).href;
const ogImage = new URL(image ?? (lang === 'ar' ? '/og/default-ar.png' : '/og/default.png'), site.url).href;

const postal = {
  '@type': 'PostalAddress',
  streetAddress: site.address.street,
  postOfficeBoxNumber: '8909',
  addressLocality: site.address.city,
  addressCountry: site.address.countryCode,
};
// ponytail: email only on purpose (WhatsApp-only policy: no telephone anywhere).
const markets = ['AE', 'SA', 'QA', 'OM', 'KW', 'BH', 'JO', 'IQ', 'EG'];
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#org`,
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  logo: { '@type': 'ImageObject', url: `${site.url}/brand/logo-192.png`, width: 187, height: 192 },
  email: cfg.contactEmail,
  foundingDate: site.founded,
  address: postal,
  location: {
    '@type': 'Place',
    name: `${site.name}, ${site.address.street}`,
    address: postal,
    geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
    hasMap: site.mapUrl,
  },
  contactPoint: [{ '@type': 'ContactPoint', contactType: 'sales', email: cfg.contactEmail, areaServed: markets, availableLanguage: ['en', 'ar'] }],
  areaServed: 'Middle East',
};
---
<!doctype html>
<html lang={lang} dir={dir(lang)} data-announce={bar ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {alternates && <link rel="canonical" href={canonical} />}
    {alternates && <link rel="alternate" hreflang="en" href={alt('en')} />}
    {alternates && <link rel="alternate" hreflang="ar" href={alt('ar')} />}
    {alternates && <link rel="alternate" hreflang="x-default" href={alt('en')} />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {alternates && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    {!image && <meta property="og:image:alt" content={site.name} />}
    <meta property="og:locale" content={lang === 'ar' ? 'ar_AE' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_US' : 'ar_AE'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#08060f" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <Font cssVariable="--font-archivo" preload={lang === 'en' ? [{ subset: 'latin' }] : false} />
    <Font cssVariable="--font-plex" preload={lang === 'en' ? [{ subset: 'latin', weight: 400 }] : false} />
    <Font cssVariable="--font-jetbrains" />
    {lang === 'ar' && <Font cssVariable="--font-kufi" preload={[{ subset: 'arabic' }]} />}
    {lang === 'ar' && <Font cssVariable="--font-plex-ar" preload={[{ subset: 'arabic', weight: 400 }]} />}
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body data-product={product}>
    {bar && <Announcement lang={lang} a={cfg.announcement} />}
    <Header lang={lang} path={path} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer lang={lang} />

    <button type="button" data-lead="whatsapp" data-product={product} class="wa-fab fixed bottom-5 end-5 z-40 inline-flex h-14 items-center gap-2 rounded-full bg-ink ps-4 pe-5 text-white shadow-[var(--shadow-pop)] transition-[transform,background-color] duration-200 hover:-translate-y-0.5 hover:bg-night-800" aria-label={t(lang, 'cta.whatsapp')}>
      <span class="flex h-8 w-8 items-center justify-center rounded-full bg-whatsapp text-white"><Icon name="whatsapp" size={18} /></span>
      <span class="hidden text-[15px] font-semibold sm:inline">WhatsApp</span>
    </button>

    {product && <Nudge lang={lang} product={product} label={productLabel ?? product} />}
    <LeadModal lang={lang} />
    <Consent lang={lang} />
  </body>
</html>
