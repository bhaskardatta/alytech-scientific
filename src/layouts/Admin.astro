---
import '../styles/global.css';
interface Props { title: string; nav?: boolean }
const { title, nav = true } = Astro.props;
const here = Astro.url.pathname;
const links = [
  { href: '/admin/', label: 'Leads' },
  { href: '/admin/visitors/', label: 'Visitors & demand' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title} · AlyTech admin</title>
    <link rel="icon" type="image/png" href="/brand/logo-96.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..700&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />
  </head>
  <body class="min-h-screen bg-surface text-[14px]">
    {nav && (
      <header class="border-b border-line bg-card">
        <div class="mx-auto flex h-14 max-w-[1400px] items-center gap-6 px-4 sm:px-6">
          <a href="/admin/" class="flex items-center gap-2"><img src="/brand/logo-96.png" width="28" height="28" alt="" /><span class="label text-mute">Admin</span></a>
          <nav class="flex gap-1">
            {links.map((l) => <a href={l.href} class:list={['rounded-xs px-3 py-1.5 font-medium transition-colors hover:bg-surface', here === l.href && 'bg-brand-50 text-brand-700']}>{l.label}</a>)}
          </nav>
          <div class="ms-auto flex items-center gap-2">
            <a href="/admin/export.csv" class="btn btn-ghost btn-sm">Export CSV</a>
            <form method="post" action="/admin/login/"><input type="hidden" name="logout" value="1" /><button class="btn btn-ghost btn-sm">Log out</button></form>
          </div>
        </div>
      </header>
    )}
    <main class="mx-auto max-w-[1400px] px-4 py-8 sm:px-6"><slot /></main>
  </body>
</html>
