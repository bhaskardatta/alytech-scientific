---
import '../styles/global.css';
import '../styles/admin.css';
import { Font } from 'astro:assets';
import Icon from '../components/Icon.astro';
import { can } from '../lib/auth';
interface Props { title: string; nav?: boolean; notice?: string; narrow?: boolean }
const { title, nav = true, notice, narrow = false } = Astro.props;
Astro.response.headers.set('cache-control', 'no-store');
const here = Astro.url.pathname;
const user = Astro.locals.user;
const owner = can(user, 'owner');
const links = [
  { href: '/admin/', label: 'Dashboard', also: '' },
  { href: '/admin/leads/', label: 'Enquiries', also: '/admin/lead/' },
  { href: '/admin/whatsapp/', label: 'WhatsApp', also: '' },
  { href: '/admin/visitors/', label: 'Visitors & demand', also: '' },
  { href: '/admin/analytics/', label: 'Analytics', also: '' },
  ...(owner ? [
    { href: '/admin/settings/', label: 'Settings', also: '' },
    { href: '/admin/users/', label: 'Users', also: '' },
    { href: '/admin/activity/', label: 'Activity', also: '' },
  ] : []),
  { href: '/admin/account/', label: 'Account', also: '' },
];
const active = (l: (typeof links)[number]) => here === l.href || (l.also !== '' && here.startsWith(l.also));
const roleLabel = { owner: 'Owner', sales: 'Sales', viewer: 'Viewer' }[user?.role ?? 'viewer'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title} · AlyTech admin</title>
    <link rel="icon" type="image/png" href="/brand/logo-96.png" />
    <Font cssVariable="--font-archivo" />
    <Font cssVariable="--font-plex" />
    <Font cssVariable="--font-jetbrains" />
  </head>
  <body class="min-h-screen bg-surface text-[14px]">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:start-4 focus:top-3 focus:z-10 focus:rounded-sm focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-white">Skip to content</a>
    {nav && (
      <header class="border-b border-line bg-card">
        <div class="mx-auto flex min-h-14 max-w-[1400px] items-center gap-3 px-4 sm:px-6 xl:gap-6">
          <a href="/admin/" class="flex shrink-0 items-center gap-2"><img src="/brand/logo-96.png" width="28" height="28" alt="" /><span class="label text-mute">Admin</span></a>
          <nav class="hidden gap-1 xl:flex" aria-label="Admin">
            {links.map((l) => <a href={l.href} class:list={['rounded-xs px-3 py-2 font-medium transition-colors hover:bg-surface', active(l) && 'bg-brand-50 text-brand-700']} aria-current={active(l) ? 'page' : undefined}>{l.label}</a>)}
          </nav>
          <div class="ms-auto flex items-center gap-2">
            {user && (
              <p class="hidden text-end leading-tight sm:block">
                <span class="block font-medium">{user.name}</span>
                <span class="label text-mute">{roleLabel}</span>
              </p>
            )}
            <form method="post" action="/admin/login/"><input type="hidden" name="logout" value="1" /><button class="btn btn-ghost btn-sm">Sign out</button></form>
            <button type="button" class="icon-btn xl:hidden" aria-expanded="false" aria-controls="admin-menu" aria-label="Menu" data-admin-menu><Icon name="menu" /></button>
          </div>
        </div>
        <nav id="admin-menu" class="hidden border-t border-line xl:hidden" aria-label="Admin menu">
          <div class="mx-auto grid max-w-[1400px] px-4 py-2 sm:grid-cols-2 sm:px-6">
            {links.map((l) => <a href={l.href} class:list={['flex min-h-12 items-center rounded-xs px-3 font-medium', active(l) && 'bg-brand-50 text-brand-700']} aria-current={active(l) ? 'page' : undefined}>{l.label}</a>)}
            {user && <p class="px-3 py-3 text-mute sm:hidden">Signed in as {user.name} ({roleLabel})</p>}
          </div>
        </nav>
      </header>
    )}
    <main id="main" tabindex="-1" class:list={['mx-auto px-4 py-6 outline-none sm:px-6 sm:py-8', narrow ? 'max-w-3xl' : 'max-w-[1400px]']}>
      {notice && <p class="mb-6 rounded-sm bg-danger/5 p-4 text-danger" role="alert">{notice}</p>}
      <slot />
    </main>
    <script>import '../scripts/admin';</script>
  </body>
</html>
