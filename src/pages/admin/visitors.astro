---
import Admin from '../../layouts/Admin.astro';
import Panel from '../../components/admin/Panel.astro';
import BarList from '../../components/admin/BarList.astro';
import PeriodPicker from '../../components/admin/PeriodPicker.astro';
import OrgTable from '../../components/admin/OrgTable.astro';
import SearchPanel from '../../components/admin/SearchPanel.astro';
import { dbReady } from '../../lib/db';
import { dbNotice } from '../../lib/admin';
import { parsePeriod } from '../../lib/period';
import { overviewOf, isIsp, type Overview } from '../../lib/stats';
export const prerender = false;

const period = parsePeriod(Astro.url.searchParams);
const showAll = Astro.url.searchParams.get('isp') === '1';
let o: Overview | undefined, error: unknown;
if (dbReady()) {
  try { o = await overviewOf(period); } catch (e) { error = e; }
}
const orgs = (o?.orgs ?? []).filter((x) => showAll || !isIsp(x.ip_org));
---
<Admin title="Visitors & demand" notice={dbNotice(error)}>
  <h1 class="display text-2xl sm:text-3xl">Visitors &amp; demand</h1>
  <p class="mt-2 max-w-2xl text-mute">Who is looking, at what, and what they couldn’t find. Companies and per-visitor figures only include people who accepted cookies.</p>
  <div class="mt-4"><PeriodPicker period={period} /></div>

  <div class="mt-6 grid grid-cols-1 gap-6 xl:grid-cols-[1.5fr_1fr]">
    <Panel title="Organisations on the site" sub="Identified from their network. Companies with their own network show by name; most home and mobile users show as their ISP.">
      <div class="mt-3"><a href={`?${period.query}${showAll ? '' : '&isp=1'}`} class="btn btn-ghost btn-sm">{showAll ? 'Hide ISPs' : 'Show ISPs'}</a></div>
      <OrgTable orgs={orgs} />
    </Panel>
    <div class="grid content-start gap-6">
      <Panel title="Most-viewed products">
        <BarList items={(o?.products_viewed ?? []).map((p) => ({ label: p.k, n: p.n }))} />
      </Panel>
      <Panel title="Most-asked-about products" sub="Enquiries sent, by product.">
        <BarList items={(o?.products_enquired ?? []).map((p) => ({ label: p.k, n: p.n }))} />
      </Panel>
      <Panel title="What people searched for" sub="Includes searches with no match: direct evidence of demand you could source.">
        <SearchPanel searches={o?.searches ?? { total: 0, with_results: 0, no_results: 0, top: [] }} limit={25} />
      </Panel>
    </div>
  </div>
</Admin>
