---
import Admin from '../../layouts/Admin.astro';
import Kpi from '../../components/admin/Kpi.astro';
import Panel from '../../components/admin/Panel.astro';
import BarList from '../../components/admin/BarList.astro';
import Trend from '../../components/admin/Trend.astro';
import Funnel from '../../components/admin/Funnel.astro';
import PeriodPicker from '../../components/admin/PeriodPicker.astro';
import OrgTable from '../../components/admin/OrgTable.astro';
import SearchPanel from '../../components/admin/SearchPanel.astro';
import { dbReady } from '../../lib/db';
import { dbNotice, num, countryName } from '../../lib/admin';
import { parsePeriod } from '../../lib/period';
import { overview, delta, deltaPoints, conversion, isIsp, type Overview, type Kpis } from '../../lib/stats';
export const prerender = false;

const period = parsePeriod(Astro.url.searchParams);
const showAll = Astro.url.searchParams.get('isp') === '1';
const zero: Kpis = { pageviews: 0, visitors: 0, enquiries: 0, partials: 0, whatsapp: 0, converted: 0, won_count: 0, won_value: 0 };
let cur: Overview | undefined, prev: Kpis = zero, error: unknown;
if (dbReady()) {
  try { ({ cur, prev } = await overview(period)); } catch (e) { error = e; }
}
const k = cur?.kpis ?? zero;
const rate = conversion(k), prevRate = conversion(prev);
const pct = (x: number) => `${(Math.round(x * 1000) / 10).toLocaleString('en-GB')}%`;

const channelName: Record<string, string> = {
  direct: 'Direct (typed or bookmarked)', search: 'Search engines', social: 'Social media', referral: 'Other websites', campaign: 'Campaigns (tagged links)',
};
const channels = Object.keys(channelName).map((c) => ({ label: channelName[c], n: cur?.channels.find((x) => x.k === c)?.n ?? 0 }));
const deviceName: Record<string, string> = { mobile: 'Phones', tablet: 'Tablets', desktop: 'Computers', unknown: 'Not recorded' };
const orgs = (cur?.orgs ?? []).filter((o) => showAll || !isIsp(o.ip_org));
const isp = (on: boolean) => `?${period.query}${on ? '&isp=1' : ''}`;
---
<Admin title="Dashboard" notice={dbNotice(error)}>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <h1 class="display text-2xl sm:text-3xl">Dashboard</h1>
  </div>
  <div class="mt-4"><PeriodPicker period={period} /></div>

  <section class="mt-6" aria-label="Key numbers">
    <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
      <Kpi label="Page views" value={num(k.pageviews)} d={delta(k.pageviews, prev.pageviews)} prevLabel={period.prevLabel} hint="Every visit, including people who haven’t accepted cookies (counted anonymously)." />
      <Kpi label="Identified visitors" value={num(k.visitors)} d={delta(k.visitors, prev.visitors)} prevLabel={period.prevLabel} hint="Only visitors who accepted cookies. Not a total of everyone." />
      <Kpi label="Enquiries sent" value={num(k.enquiries)} d={delta(k.enquiries, prev.enquiries)} prevLabel={period.prevLabel} hint="Website forms submitted, spam excluded." />
      <Kpi label="Started, not sent" value={num(k.partials)} d={delta(k.partials, prev.partials)} prevLabel={period.prevLabel} neutral hint="Forms left half-filled: worth a follow-up." />
      <Kpi label="WhatsApp chats started" value={num(k.whatsapp)} d={delta(k.whatsapp, prev.whatsapp)} prevLabel={period.prevLabel} hint="Clicks on a WhatsApp button." />
      <Kpi label="Conversion rate" value={pct(rate)} d={deltaPoints(rate, prevRate)} prevLabel={period.prevLabel} hint="Of identified visitors, the share who sent an enquiry or started a WhatsApp chat." />
      <Kpi label="Deals won" value={num(k.won_count)} d={delta(k.won_count, prev.won_count)} prevLabel={period.prevLabel} hint="Enquiries moved to Won in this period." />
      <Kpi label="Won value (AED)" value={num(Math.round(k.won_value))} d={delta(k.won_value, prev.won_value)} prevLabel={period.prevLabel} hint="Total of the deal values entered on won enquiries." />
    </div>
  </section>

  <Panel title="Daily trend" sub="Each chart has its own scale. Hover or use the arrow keys to read a day." class="mt-6">
    <Trend days={cur?.daily ?? []} />
  </Panel>

  <div class="mt-6 grid grid-cols-1 items-start gap-6 lg:grid-cols-2">
    <Panel title="Where visitors come from" sub="Page views by how the visitor arrived. Navigation inside the site isn’t counted.">
      <BarList items={channels} total={channels.reduce((s, c) => s + c.n, 0)} />
      {(cur?.referrers.length ?? 0) > 0 && (
        <div class="mt-6 border-t border-line pt-4">
          <h3 class="label text-mute">Top sites sending visitors</h3>
          <BarList items={cur!.referrers.slice(0, 5).map((r) => ({ label: r.k, n: r.n }))} />
        </div>
      )}
      {(cur?.campaigns.length ?? 0) > 0 && (
        <div class="mt-6 border-t border-line pt-4">
          <h3 class="label text-mute">Campaigns</h3>
          <BarList items={cur!.campaigns.slice(0, 5).map((r) => ({ label: r.k, n: r.n }))} />
        </div>
      )}
    </Panel>
    <Panel title="From page view to enquiry" sub="How many of the visitors who looked at a product went on to ask.">
      <Funnel viewed={cur?.funnel.viewed ?? 0} opened={cur?.funnel.opened ?? 0} submitted={cur?.funnel.submitted ?? 0} />
    </Panel>
  </div>

  <div class="mt-6 grid grid-cols-1 items-start gap-6 lg:grid-cols-3">
    <Panel title="Countries" sub="By page views, from the visitor’s connection.">
      <BarList items={(cur?.countries ?? []).map((c) => ({ label: countryName(c.k), n: c.n }))} total={k.pageviews} />
    </Panel>
    <Panel title="Devices">
      <BarList items={(cur?.devices ?? []).map((c) => ({ label: deviceName[c.k] ?? c.k, n: c.n }))} total={k.pageviews} />
    </Panel>
    <Panel title="Top pages">
      <BarList items={(cur?.pages ?? []).map((c) => ({ label: c.k, n: c.n }))} />
    </Panel>
  </div>

  <div class="mt-6 grid grid-cols-1 items-start gap-6 lg:grid-cols-2">
    <Panel title="Most-viewed products">
      <BarList items={(cur?.products_viewed ?? []).map((c) => ({ label: c.k, n: c.n }))} />
    </Panel>
    <Panel title="Most-asked-about products" sub="Enquiries sent, by product.">
      <BarList items={(cur?.products_enquired ?? []).map((c) => ({ label: c.k, n: c.n }))} />
    </Panel>
  </div>

  <div class="mt-6 grid grid-cols-1 items-start gap-6 xl:grid-cols-2">
    <Panel title="Site searches" sub="Searches with no result show demand you could source.">
      <SearchPanel searches={cur?.searches ?? { total: 0, with_results: 0, no_results: 0, top: [] }} limit={8} />
    </Panel>
    <Panel title="Companies on the site" sub="Identified from their network; home and mobile users show as their ISP.">
      <div class="mt-3 flex flex-wrap gap-2">
        <a href={isp(!showAll)} class="btn btn-ghost btn-sm">{showAll ? 'Hide ISPs' : 'Show ISPs'}</a>
        <a href={`/admin/visitors/?${period.query}`} class="btn btn-ghost btn-sm">All organisations →</a>
      </div>
      <OrgTable orgs={orgs} limit={8} />
    </Panel>
  </div>
</Admin>
