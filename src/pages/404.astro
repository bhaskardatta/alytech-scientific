---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
// One static 404 serves every missing URL (Vercel and Cloudflare both serve /404.html), so it carries both languages and
// switches to Arabic, right-to-left, when the missing URL is under /ar/.
---
<Base lang="en" title="Page not found | AlyTech Scientific" description="The page you were looking for has moved or no longer exists. Search our laboratory instruments or message an AlyTech engineer on WhatsApp." noindex alternates={false}>
  <section class="flex min-h-[80vh] items-center bg-card pt-[72px]">
    <div class="wrap max-w-2xl py-16" data-nf="en">
      <p class="label text-brand-600">404</p>
      <h1 class="display mt-4 text-[clamp(2rem,4.4vw,3.2rem)]">That page has moved or no longer exists.</h1>
      <form action="/search/" method="get" class="mt-8 flex gap-2" role="search">
        <label for="nf-q" class="sr-only">Search instruments</label>
        <input id="nf-q" name="q" class="field" placeholder="Search instruments" />
        <button class="btn btn-primary">Search</button>
      </form>
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
        <a href="/" class="link-arrow">Home <Icon name="arrow" size={16} /></a>
        <button type="button" class="link-arrow" data-lead="whatsapp"><Icon name="whatsapp" size={18} />WhatsApp an engineer</button>
      </div>
    </div>
    <div class="wrap hidden max-w-2xl py-16" data-nf="ar" lang="ar" dir="rtl">
      <p class="label text-brand-600">404</p>
      <h1 class="display mt-4 text-[clamp(2rem,4.4vw,3.2rem)]">الصفحة غير موجودة أو تم نقلها.</h1>
      <form action="/ar/search/" method="get" class="mt-8 flex gap-2" role="search">
        <label for="nf-q-ar" class="sr-only">ابحث عن جهاز</label>
        <input id="nf-q-ar" name="q" class="field" placeholder="ابحث عن جهاز" />
        <button class="btn btn-primary">بحث</button>
      </form>
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
        <a href="/ar/" class="link-arrow">الرئيسية <Icon name="arrow" size={16} flip /></a>
        <button type="button" class="link-arrow" data-lead="whatsapp"><Icon name="whatsapp" size={18} />راسل مهندساً عبر واتساب</button>
      </div>
    </div>
  </section>
</Base>

<script>
  if (/^\/ar(\/|$)/.test(location.pathname)) {
    document.querySelector('[data-nf="en"]')?.remove();
    document.querySelector('[data-nf="ar"]')?.classList.remove('hidden');
    document.documentElement.lang = 'ar';
    document.documentElement.dir = 'rtl';
    document.title = 'الصفحة غير موجودة | AlyTech Scientific';
  }
</script>
