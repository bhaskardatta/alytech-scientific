# Server-only secrets — set in Vercel → Project → Settings → Environment Variables.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Admin panel login (/admin/). Use a long random password; ADMIN_SECRET signs the session cookie.
ADMIN_PASSWORD=
ADMIN_SECRET=
# Optional: company lookup from visitor IP (free tier at ipinfo.io).
IPINFO_TOKEN=
# Optional: instant email alert for every submitted lead (resend.com).
RESEND_API_KEY=
LEAD_ALERT_TO=alytech@alytechme.ae
LEAD_ALERT_FROM=AlyTech Website <leads@alytechme.com>
# Optional: PostHog product analytics + session replay (EU cloud, loads only after "Accept").
# Project API key (phc_…, public by design) — baked into the client at build time, so redeploy after setting it.
PUBLIC_POSTHOG_KEY=
# PostHog project id (number in the project URL) — turns on "Watch session" links in the admin panel.
POSTHOG_PROJECT_ID=
