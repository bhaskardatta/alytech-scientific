# Server-only secrets — set in the host's environment variables (Vercel → Project → Settings → Environment Variables; Cloudflare Workers: `npx wrangler secret put NAME`,
# or a .dev.vars file locally; see wrangler.jsonc and docs/cloudflare-go-live.md).
# Cloudflare builds (npm run build:cf) also read SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY at build time from the build environment or .dev.vars,
# so the site settings (WhatsApp number, announcement bar, hours) are baked into the pages; without them the defaults in src/data/site.ts are used.
# Server code reads them all through src/lib/env.ts (astro:env). Only PUBLIC_POSTHOG_KEY is read by the browser bundle.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Admin panel (/admin/) ----
# Cloudflare only (src/worker.ts): ADMIN_HOST=admin.alytechme.com serves the panel on its own host with clean URLs (no /admin prefix), and
# /admin/* on any other host redirects there. Leave it unset and the panel stays at /admin/ on the main host. Ignored on Vercel.
ADMIN_HOST=
# ADMIN_SECRET signs the session cookie: 32+ random characters. Required.
ADMIN_SECRET=
# One-time setup password. While no account exists, signing in with it lets you create the FIRST OWNER account in the browser.
# Afterwards it does nothing, unless ADMIN_BREAKGLASS=1 (below).
ADMIN_PASSWORD=
# Optional emergency access: set to 1 and the admin sign-in accepts email "breakglass" + ADMIN_PASSWORD as an owner (every use is logged).
# Leave it unset in normal operation, and turn it back off after use.
ADMIN_BREAKGLASS=

# ---- Daily job (/api/cron/daily/) ----
# Long random string. Vercel Cron sends it as "Authorization: Bearer <value>" automatically; the job refuses requests without it.
# It keeps the free Supabase project awake, purges old data, emails follow-up reminders and (Mondays) the owners' weekly digest.
CRON_SECRET=

# ---- Site settings → "Save & publish" ----
# Deploy hook that rebuilds the site (Vercel → Project → Settings → Git → Deploy Hooks). Without it the settings page still saves,
# but you must redeploy by hand for the changes to reach the pages.
DEPLOY_HOOK_URL=

# Optional: company lookup from visitor IP (free tier at ipinfo.io).
IPINFO_TOKEN=
# Optional: email via Resend (resend.com): instant lead alerts, follow-up reminders and the weekly digest. Without a key, emails are skipped silently.
RESEND_API_KEY=
# Default recipients of the instant lead alert. Owners can override the list in Admin → Settings.
LEAD_ALERT_TO=alytech@alytechme.ae
LEAD_ALERT_FROM=AlyTech Website <leads@alytechme.com>

# Optional: PostHog product analytics + session replay (EU cloud, loads only after "Accept").
# Project API key (phc_…, public by design) — baked into the client at build time, so redeploy after setting it.
PUBLIC_POSTHOG_KEY=
# PostHog project id (number in the project URL) — turns on "Watch session" links and the Analytics link in the admin panel.
POSTHOG_PROJECT_ID=
# Optional: a PostHog dashboard shared publicly (Share → "Share dashboard publicly"), shown inside Admin → Analytics. Must be on eu.posthog.com.
POSTHOG_SHARED_DASHBOARD_URL=
